---
import '@fontsource-variable/inter';
import '@fontsource-variable/literata';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/markdown.css';

import Header from '../components/Header.astro';
import SidebarTree from '../components/SidebarTree';
import TableOfContents from '../components/TableOfContents';
import BacklinksPanel from '../components/BacklinksPanel';
import CommandPalette from '../components/CommandPalette';
import type {
  BacklinkItem,
  DocMetadata,
  HeadingItem,
  NavigationNode,
  OutgoingLinkItem,
} from '../lib/types';
import { DOMAIN_COLORS, SITE } from '../lib/constants';
import {
  ArrowLeft,
  ArrowRight,
  Clock,
  FileText,
  Hash,
  ListTree,
  PanelLeftOpen,
  Pin,
  Sparkles,
  X,
} from 'lucide-react';

interface RelatedDoc {
  title: string;
  slug: string;
  domainTitle?: string;
  summary?: string;
}

interface Props {
  title: string;
  description?: string;
  doc?: DocMetadata;
  headings?: HeadingItem[];
  backlinks?: BacklinkItem[];
  outgoing?: OutgoingLinkItem[];
  navigation: NavigationNode[];
  prevDoc?: { title: string; slug: string } | null;
  nextDoc?: { title: string; slug: string } | null;
  related?: RelatedDoc[];
  eyebrow?: string;
  noIndex?: boolean;
  wide?: boolean;
  canonicalPath?: string;
}

const {
  title,
  description = SITE.description,
  doc,
  headings = [],
  backlinks = [],
  outgoing = [],
  navigation,
  prevDoc = null,
  nextDoc = null,
  related = [],
  eyebrow,
  noIndex = false,
  wide = false,
  canonicalPath,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const site = Astro.site ?? new URL('https://java-masterclass.dev');
const canonical = new URL(canonicalPath ?? pathname, site).toString();
const pageTitle =
  pathname === '/' ? `${SITE.name} — ${SITE.tagline}` : `${title} — ${SITE.name}`;
const ogImage = new URL('/og-image.png', site).toString();
const domainColor = doc ? DOMAIN_COLORS[doc.domain] : null;

const domainHref = doc
  ? doc.domain === 'root'
    ? '/overview'
    : doc.domain === 'java-dsa'
      ? '/java-dsa'
      : `/${doc.domain}`
  : '/';

const fileParts = doc ? doc.filePath.split('/') : [];
const moduleSegment = fileParts.length > 2 ? fileParts[1] : null;
const categoryHref = moduleSegment
  ? `/${doc!.domain}/${moduleSegment.toLowerCase().replace(/_/g, '-')}`
  : domainHref;

const breadcrumbs = doc
  ? doc.kind === 'domain'
    ? [{ title: doc.domainTitle, slug: domainHref }]
    : doc.domain === 'root'
    ? [
        { title: 'Start Here', slug: '/overview' },
        { title: doc.title, slug: doc.slug },
      ]
    : [
        { title: doc.domainTitle, slug: domainHref },
        { title: doc.categoryTitle, slug: categoryHref },
      ]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      url: site.origin,
      name: SITE.name,
      description: SITE.description,
      inLanguage: 'en',
      potentialAction: {
        '@type': 'SearchAction',
        target: `${site.origin}/search?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    doc
      ? {
          '@type': ['TechArticle', 'LearningResource'],
          '@id': `${canonical}#article`,
          headline: doc.title,
          name: doc.title,
          description: doc.summary || description,
          url: canonical,
          isPartOf: { '@id': `${site.origin}/#website` },
          about: doc.domainTitle,
          keywords: doc.tags.join(', '),
          timeRequired: `PT${doc.readingTimeMinutes}M`,
          wordCount: doc.wordCount,
          inLanguage: 'en',
          educationalLevel: doc.level || 'Intermediate',
        }
      : {
          '@type': 'WebPage',
          '@id': `${canonical}#webpage`,
          name: title,
          description,
          url: canonical,
          isPartOf: { '@id': `${site.origin}/#website` },
          inLanguage: 'en',
        },
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#09090d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content={doc ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang="en" href={canonical} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        const theme =
          stored ||
          (window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark');
        document.documentElement.setAttribute('data-theme', theme);

        if (localStorage.getItem('obsidian-sidebar-folded') === 'true') {
          document.documentElement.classList.add('sidebar-folded', 'no-transitions');
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              document.documentElement.classList.remove('no-transitions');
            });
          });
        }
        const widthMode = localStorage.getItem('obsidian-theory-width');
        if (widthMode) {
          document.documentElement.setAttribute('data-theory-width', widthMode);
        }
      } catch (_) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
  </head>

  <body
    class="bg-obs-canvas text-obs-text-secondary antialiased selection:bg-obs-accent/20 selection:text-obs-accent"
  >
    <a
      href="#main-content-wrapper"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-lg focus:bg-obs-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-[#0b0714] focus:shadow-xl focus:outline-none"
    >
      Skip to content
    </a>

    <div
      id="reading-progress"
      class="fixed left-0 top-0 z-[60] h-0.5 w-0 bg-gradient-to-r from-obs-accent to-obs-gold transition-[width] duration-75"
      role="presentation"
      aria-hidden="true"
    ></div>

    <div data-pagefind-ignore class="contents">
      <Header breadcrumbs={breadcrumbs} />
    </div>

    <!-- Docked Edge Pull Tab when sidebar is folded (desktop only, flush to edge) -->
    <aside
      id="sidebar-edge-tab"
      data-pagefind-ignore
      class="no-print fixed left-0 top-[calc(var(--obs-header-height)+1.25rem)] z-30 hidden md:block"
      aria-label="Unfold sidebar navigation"
    >
      <button
        id="sidebar-edge-unfold-btn"
        type="button"
        class="group relative flex h-9 w-9 items-center justify-center rounded-r-xl border border-l-0 border-obs-border/80 bg-obs-surface/95 text-obs-text-secondary shadow-obs-md backdrop-blur-md transition-all duration-200 hover:w-auto hover:px-3 hover:gap-2 hover:border-obs-accent/60 hover:bg-obs-surface-hover hover:text-obs-accent hover:shadow-obs-lg active:scale-95"
        title="Unfold navigation sidebar ([ or Ctrl+B)"
        aria-label="Unfold navigation sidebar"
        aria-controls="left-sidebar"
        aria-expanded="false"
      >
        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-obs-accent/15 text-obs-accent transition-colors group-hover:bg-obs-accent/25">
          <PanelLeftOpen className="h-3.5 w-3.5" />
        </span>
        <span class="hidden whitespace-nowrap text-xs font-semibold tracking-wide group-hover:inline-block">
          Explore
        </span>
        <kbd class="hidden items-center rounded border border-obs-border/60 bg-obs-canvas-soft px-1 text-[0.58rem] font-mono text-obs-text-muted group-hover:inline-flex">
          [
        </kbd>
      </button>
    </aside>

    <div id="app-shell" class="mx-auto flex w-full max-w-[112rem]">
      <aside
        id="left-sidebar"
        data-pagefind-ignore
        class="sticky top-[var(--obs-header-height)] hidden h-[calc(100vh-var(--obs-header-height))] w-[var(--obs-sidebar-width)] shrink-0 overflow-hidden border-r border-obs-border bg-obs-sidebar/70 backdrop-blur-md md:block z-20"
        aria-label="Knowledge base navigation"
      >
        <div class="h-full w-[var(--obs-sidebar-width)] min-w-[19rem] overflow-hidden">
          <SidebarTree client:load navigation={navigation} currentSlug={pathname} />
        </div>
      </aside>

      <div id="content-grid" class="flex min-w-0 flex-1 flex-col xl:flex-row transition-all duration-300">
        <main
          id="main-content-wrapper"
          tabindex="-1"
          class="min-w-0 flex-1 px-4 pb-20 pt-7 focus:outline-none sm:px-6 lg:px-10 transition-all duration-300"
        >
          <div
            id="theory-reading-container"
            class:list={[
              'mx-auto w-full transition-[max-width,width] duration-300 ease-in-out',
              wide ? 'page-wide-mode' : 'theory-content-container'
            ]}
          >
            {headings.length > 0 && (
              <details
                class="no-print mb-5 rounded-xl border border-obs-border bg-obs-surface/70 px-3 py-2 xl:hidden"
              >
                <summary class="flex cursor-pointer items-center gap-2 text-xs font-semibold text-obs-text-primary">
                  <ListTree className="h-3.5 w-3.5 text-obs-accent" />
                  On this page
                  <span class="ml-auto font-mono text-[0.62rem] font-normal text-obs-text-muted">
                    {headings.filter((heading) => heading.depth >= 2).length} sections
                  </span>
                </summary>
                <nav class="mt-2 max-h-72 overflow-y-auto border-t border-obs-border-subtle pt-2" aria-label="On this page">
                  <ul class="space-y-0.5">
                    {headings
                      .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
                      .map((heading) => (
                        <li>
                          <a
                            href={`#${heading.slug}`}
                            style={`padding-left:${(heading.depth - 2) * 0.7}rem`}
                            class="block rounded px-1.5 py-1 text-[0.76rem] text-obs-text-muted hover:bg-obs-hover hover:text-obs-accent"
                          >
                            {heading.text}
                          </a>
                        </li>
                      ))}
                  </ul>
                </nav>
              </details>
            )}

            {doc ? (
              <header class="mb-8 overflow-hidden rounded-2xl border border-obs-border bg-gradient-to-b from-obs-surface to-obs-canvas-soft/60 shadow-obs">
                <div class="space-y-5 p-5 sm:p-7">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex min-w-0 flex-wrap items-center gap-2 text-[0.68rem]">
                      <a
                        href={
                          doc.domain === 'root'
                            ? '/overview'
                            : doc.domain === 'java-dsa'
                              ? '/java-dsa'
                              : `/${doc.domain}`
                        }
                        class="rounded-full border px-2.5 py-1 font-bold uppercase tracking-[0.1em]"
                        style={{
                          backgroundColor: domainColor?.bg,
                          color: domainColor?.text,
                          borderColor: domainColor?.border,
                        }}
                      >
                        {doc.domainTitle}
                      </a>
                      <span class="text-obs-text-muted" aria-hidden="true">/</span>
                      <span class="truncate font-medium text-obs-text-muted">{doc.categoryTitle}</span>
                      {doc.level && <span class="badge">{doc.level}</span>}
                      {doc.kind === 'standard' && (
                        <span class="badge border-obs-gold/40 text-obs-gold">Standard</span>
                      )}
                    </div>

                    <div class="flex items-center gap-2">
                      <button
                        id="pin-page-btn"
                        type="button"
                        data-slug={doc.slug}
                        data-title={doc.title}
                        data-domain={doc.domainTitle}
                        class="inline-flex items-center gap-1.5 rounded-md border border-obs-border bg-obs-canvas-soft px-2 py-1 text-[0.66rem] font-semibold text-obs-text-muted transition-colors hover:border-obs-gold/50 hover:text-obs-gold"
                        title="Pin this page"
                        aria-pressed="false"
                      >
                        <Pin className="h-3 w-3" />
                        <span class="pin-text">Pin</span>
                      </button>
                    </div>
                  </div>

                  <div class="space-y-3">
                    <h1 class="text-balance text-[1.85rem] font-bold leading-[1.18] tracking-tight text-obs-text-primary sm:text-[2.2rem]">
                      {doc.title}
                    </h1>
                    {doc.summary && (
                      <p class="max-w-[48rem] text-pretty text-[0.92rem] leading-relaxed text-obs-text-muted">
                        {doc.summary}
                      </p>
                    )}
                  </div>

                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-obs-border-subtle pt-3 text-[0.68rem] text-obs-text-muted">
                    <span class="inline-flex items-center gap-1.5">
                      <Clock className="h-3.5 w-3.5 text-obs-accent" />
                      {doc.readingTimeMinutes} min read
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <FileText className="h-3.5 w-3.5 text-obs-accent" />
                      {doc.wordCount.toLocaleString('en-US')} words
                    </span>
                    {doc.headings.length > 0 && (
                      <span class="inline-flex items-center gap-1.5">
                        <Hash className="h-3.5 w-3.5 text-obs-accent" />
                        {doc.headings.filter((heading) => heading.depth === 2).length} sections
                      </span>
                    )}
                    {doc.interviewFrequency && (
                      <span class="inline-flex items-center gap-1.5 text-obs-gold">
                        <Sparkles className="h-3.5 w-3.5" />
                        {doc.interviewFrequency}
                      </span>
                    )}
                    {doc.lastUpdated && <span>Updated {doc.lastUpdated}</span>}
                  </div>

                  {doc.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {doc.tags.slice(0, 9).map((tag) => (
                        <a
                          href={`/tags/${encodeURIComponent(tag)}`}
                          class="rounded-md border border-obs-border-subtle bg-obs-canvas-soft px-1.5 py-0.5 font-mono text-[0.62rem] text-obs-text-muted transition-colors hover:border-obs-accent/40 hover:text-obs-accent"
                        >
                          #{tag}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </header>
            ) : (
              eyebrow && (
                <div class="mb-6">
                  <p class="eyebrow">{eyebrow}</p>
                </div>
              )
            )}

            <article
              class:list={[doc ? 'obsidian-prose' : 'page-body']}
              data-pagefind-body={noIndex ? undefined : true}
              data-pagefind-meta={`domain:${doc?.domainTitle ?? ''}`}
            >
              <slot />
            </article>

            {related.length > 0 && (
              <section class="no-print mt-14 border-t border-obs-border pt-8" aria-labelledby="related-heading">
                <div class="mb-4 flex items-center justify-between">
                  <h2 id="related-heading" class="text-[0.7rem] font-bold uppercase tracking-[0.14em] text-obs-text-muted">
                    Related topics
                  </h2>
                  <a href="/library" class="text-[0.7rem] font-semibold text-obs-accent hover:underline">
                    Browse library
                  </a>
                </div>
                <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
                  {related.map((item) => (
                    <a
                      href={item.slug}
                      class="group rounded-xl border border-obs-border bg-obs-surface/60 p-3.5 transition-colors hover:border-obs-accent/40 hover:bg-obs-hover"
                    >
                      {item.domainTitle && (
                        <span class="text-[0.6rem] font-bold uppercase tracking-[0.12em] text-obs-accent/80">
                          {item.domainTitle}
                        </span>
                      )}
                      <h3 class="mt-1 text-[0.88rem] font-semibold leading-snug text-obs-text-primary group-hover:text-obs-accent">
                        {item.title}
                      </h3>
                      {item.summary && (
                        <p class="mt-1 line-clamp-2 text-[0.72rem] leading-relaxed text-obs-text-muted">
                          {item.summary}
                        </p>
                      )}
                    </a>
                  ))}
                </div>
              </section>
            )}

            {(prevDoc || nextDoc) && (
              <nav
                class="no-print mt-10 grid grid-cols-1 gap-3 border-t border-obs-border pt-6 sm:grid-cols-2"
                aria-label="Previous and next topic"
              >
                {prevDoc ? (
                  <a
                    href={prevDoc.slug}
                    class="group flex flex-col rounded-xl border border-obs-border bg-obs-surface/60 p-4 transition-colors hover:border-obs-accent/40 hover:bg-obs-hover"
                  >
                    <span class="inline-flex items-center gap-1 text-[0.6rem] font-bold uppercase tracking-[0.12em] text-obs-text-muted group-hover:text-obs-accent">
                      <ArrowLeft className="h-3 w-3" /> Previous
                    </span>
                    <span class="mt-1 line-clamp-2 text-[0.84rem] font-semibold text-obs-text-primary">
                      {prevDoc.title}
                    </span>
                  </a>
                ) : (
                  <div class="hidden sm:block"></div>
                )}
                {nextDoc && (
                  <a
                    href={nextDoc.slug}
                    class="group flex flex-col items-end rounded-xl border border-obs-border bg-obs-surface/60 p-4 text-right transition-colors hover:border-obs-accent/40 hover:bg-obs-hover sm:col-start-2"
                  >
                    <span class="inline-flex items-center gap-1 text-[0.6rem] font-bold uppercase tracking-[0.12em] text-obs-text-muted group-hover:text-obs-accent">
                      Next <ArrowRight className="h-3 w-3" />
                    </span>
                    <span class="mt-1 line-clamp-2 text-[0.84rem] font-semibold text-obs-text-primary">
                      {nextDoc.title}
                    </span>
                  </a>
                )}
              </nav>
            )}

            <footer class="no-print mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-obs-border-subtle pt-5 text-[0.66rem] text-obs-text-muted">
              <p>
                {doc ? 'Found an issue? Every chapter is plain Markdown in the repository.' : 'Java Masterclass · A connected knowledge base.'}
              </p>
              <div class="flex items-center gap-3">
                <a href="/docs/authoring" class="hover:text-obs-accent">Authoring</a>
                <a href="/docs/deployment" class="hover:text-obs-accent">Deployment</a>
                <a href="/search" class="hover:text-obs-accent">Search</a>
                <a href="/graph" class="hover:text-obs-accent">Graph</a>
              </div>
            </footer>
          </div>
        </main>

        {(doc || headings.length > 0 || backlinks.length > 0 || outgoing.length > 0) && (
        <aside
          id="right-sidebar"
          data-pagefind-ignore
          class="sticky top-[var(--obs-header-height)] hidden h-[calc(100vh-var(--obs-header-height))] w-[var(--obs-toc-width)] shrink-0 overflow-y-auto border-l border-obs-border bg-obs-sidebar/30 px-5 py-7 xl:block"
          aria-label="Page outline and connections"
        >
          <div class="space-y-6">
            <TableOfContents client:idle headings={headings} />
            <BacklinksPanel client:idle backlinks={backlinks} outgoing={outgoing} />
            <div class="border-t border-obs-border-subtle pt-4">
              <a
                href="/checklist"
                class="flex items-center justify-between rounded-lg border border-obs-border bg-obs-surface px-3 py-2 text-[0.72rem] font-semibold text-obs-text-secondary transition-colors hover:border-obs-emerald/40 hover:text-obs-emerald"
              >
                Study checklist
                <ArrowRight className="h-3 w-3" />
              </a>
            </div>
          </div>
        </aside>
        )}
      </div>
    </div>

    <!-- Mobile navigation drawer -->
    <div
      id="mobile-drawer"
      data-pagefind-ignore
      class="fixed inset-0 z-50 hidden md:hidden"
      role="dialog"
      aria-modal="true"
      aria-label="Navigation menu"
    >
      <div id="mobile-drawer-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
      <div class="absolute inset-y-0 left-0 flex w-[min(21rem,90vw)] flex-col border-r border-obs-border bg-obs-sidebar shadow-2xl">
        <div class="flex h-14 items-center justify-between border-b border-obs-border px-3">
          <a href="/" class="flex items-center gap-2 text-sm font-bold text-obs-text-primary">
            <span class="flex h-7 w-7 items-center justify-center rounded-md border border-obs-accent/35 bg-obs-accent/10 text-obs-accent">
              <Sparkles className="h-3.5 w-3.5" />
            </span>
            Java Masterclass
          </a>
          <button id="mobile-drawer-close" type="button" class="icon-btn" aria-label="Close navigation menu">
            <X className="h-4 w-4" />
          </button>
        </div>
        <div class="min-h-0 flex-1">
          <SidebarTree client:idle navigation={navigation} currentSlug={pathname} />
        </div>
      </div>
    </div>

    <div id="command-palette-root" data-pagefind-ignore>
      <CommandPalette client:idle />
    </div>

    <button
      id="back-to-top"
      type="button"
      class="no-print fixed bottom-5 right-5 z-30 hidden h-9 w-9 items-center justify-center rounded-full border border-obs-border bg-obs-surface text-obs-text-secondary shadow-lg transition hover:border-obs-accent/40 hover:text-obs-accent"
      aria-label="Back to top"
    >
      <ArrowRight className="h-4 w-4 -rotate-90" />
    </button>

    <div
      id="diagram-lightbox"
      class="fixed inset-0 z-[70] hidden flex-col bg-black/80 p-4 md:p-8 backdrop-blur-md"
      role="dialog"
      aria-modal="true"
      aria-label="Expanded diagram"
    >
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between pb-3 text-white">
        <span class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-white/70">
          Diagram view
        </span>
        <button
          id="close-lightbox-btn"
          type="button"
          class="rounded-md border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-semibold text-white hover:bg-white/20 transition-colors"
        >
          Close (Esc)
        </button>
      </div>
      <div
        id="lightbox-content"
        class="obsidian-prose mx-auto flex w-full max-w-6xl flex-1 items-center justify-center overflow-auto rounded-xl border border-obs-border bg-obs-base p-6 text-obs-text-primary shadow-2xl"
      ></div>
    </div>

    <script>
      import mermaid from 'mermaid';

      const root = document.documentElement;

      /* ---------------------------------------------------------------- theme */
      function applyThemeIcons() {
        const isDark = root.getAttribute('data-theme') !== 'light';
        document.querySelectorAll<HTMLElement>('.theme-icon-light').forEach((element) => {
          element.classList.toggle('hidden', !isDark);
        });
        document.querySelectorAll<HTMLElement>('.theme-icon-dark').forEach((element) => {
          element.classList.toggle('hidden', isDark);
        });
      }

      function setTheme(next: 'light' | 'dark') {
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* ignore */
        }
        applyThemeIcons();
        rerenderMermaid();
      }

      function setupTheme() {
        applyThemeIcons();
        const button = document.getElementById('theme-toggle-btn');
        if (!button || button.dataset.bound === 'true') return;
        button.dataset.bound = 'true';
        button.addEventListener('click', () => {
          setTheme(root.getAttribute('data-theme') === 'light' ? 'dark' : 'light');
        });
      }

      /* --------------------------------------------------------- reading mode */
      function setupReadingMode() {
        const button = document.getElementById('reading-mode-btn');
        try {
          if (localStorage.getItem('zen-mode') === 'true') {
            document.body.classList.add('zen-mode');
          }
        } catch {
          /* ignore */
        }
        const active = document.body.classList.contains('zen-mode');
        button?.setAttribute('aria-pressed', String(active));
        if (!button || button.dataset.bound === 'true') return;
        button.dataset.bound = 'true';
        button.addEventListener('click', () => {
          const enabled = document.body.classList.toggle('zen-mode');
          button.setAttribute('aria-pressed', String(enabled));
          try {
            localStorage.setItem('zen-mode', String(enabled));
          } catch {
            /* ignore */
          }
        });
      }

      /* -------------------------------------------------------- sidebar toggle */
      function toggleSidebar(forceState?: boolean) {
        const next =
          typeof forceState === 'boolean'
            ? forceState
            : !root.classList.contains('sidebar-folded');
        root.classList.toggle('sidebar-folded', next);
        try {
          localStorage.setItem('obsidian-sidebar-folded', String(next));
        } catch {
          /* ignore */
        }
        updateSidebarButtons();
      }

      function updateSidebarButtons() {
        const isFolded = root.classList.contains('sidebar-folded');
        const desktopBtn = document.getElementById('desktop-sidebar-toggle-btn');
        if (desktopBtn) {
          desktopBtn.setAttribute('aria-expanded', String(!isFolded));
          desktopBtn.title = isFolded
            ? 'Expand navigation sidebar ([ or Ctrl+B)'
            : 'Collapse navigation sidebar ([ or Ctrl+B)';
          desktopBtn.setAttribute(
            'aria-label',
            isFolded ? 'Expand navigation sidebar' : 'Collapse navigation sidebar'
          );
        }
        const edgeBtn = document.getElementById('sidebar-edge-unfold-btn');
        if (edgeBtn) {
          edgeBtn.setAttribute('aria-expanded', String(!isFolded));
        }
        window.dispatchEvent(
          new CustomEvent('obsidian:sidebar-toggled', { detail: { folded: isFolded } })
        );
        setTimeout(() => {
          window.dispatchEvent(new Event('resize'));
        }, 310);
      }

      function setupSidebar() {
        const desktopBtn = document.getElementById('desktop-sidebar-toggle-btn');
        if (desktopBtn && desktopBtn.dataset.bound !== 'true') {
          desktopBtn.dataset.bound = 'true';
          desktopBtn.addEventListener('click', () => toggleSidebar());
        }

        const edgeBtn = document.getElementById('sidebar-edge-unfold-btn');
        if (edgeBtn && edgeBtn.dataset.bound !== 'true') {
          edgeBtn.dataset.bound = 'true';
          edgeBtn.addEventListener('click', () => toggleSidebar(false));
        }

        document.querySelectorAll<HTMLElement>('.sidebar-fold-btn').forEach((btn) => {
          if (btn.dataset.bound !== 'true') {
            btn.dataset.bound = 'true';
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              toggleSidebar(true);
            });
          }
        });

        if (!root.dataset.sidebarListenerBound) {
          root.dataset.sidebarListenerBound = 'true';
          window.addEventListener('obsidian:toggle-sidebar', (e: any) => {
            if (e?.detail && typeof e.detail.folded === 'boolean') {
              toggleSidebar(e.detail.folded);
            } else {
              toggleSidebar();
            }
          });
        }

        updateSidebarButtons();
      }

      /* ---------------------------------------------------- theory width mode */
      function setupTheoryWidth() {
        const button = document.getElementById('reading-width-btn');
        if (!button || button.dataset.bound === 'true') return;
        button.dataset.bound = 'true';

        const syncWidth = () => {
          const isWide = root.getAttribute('data-theory-width') === 'wide';
          button.setAttribute('aria-pressed', String(isWide));
          button.title = isWide
            ? 'Reset balanced reading width (W)'
            : 'Expand to dynamic wide reading width (W)';
          button.querySelector('.width-icon-normal')?.classList.toggle('hidden', isWide);
          button.querySelector('.width-icon-wide')?.classList.toggle('hidden', !isWide);
        };

        syncWidth();

        button.addEventListener('click', () => {
          const next = root.getAttribute('data-theory-width') === 'wide' ? 'normal' : 'wide';
          root.setAttribute('data-theory-width', next);
          try {
            localStorage.setItem('obsidian-theory-width', next);
          } catch {
            /* ignore */
          }
          syncWidth();
          setTimeout(() => {
            window.dispatchEvent(new Event('resize'));
          }, 310);
        });
      }

      /* ---------------------------------------------------------- progress bar */
      function updateProgress() {
        const bar = document.getElementById('reading-progress');
        if (!bar) return;
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = scrollable <= 0 ? '0%' : `${Math.min(100, Math.max(0, (window.scrollY / scrollable) * 100))}%`;
        const backToTop = document.getElementById('back-to-top');
        backToTop?.classList.toggle('hidden', window.scrollY < 700);
      }

      /* ---------------------------------------------------------- mobile menu */
      function setupDrawer() {
        const drawer = document.getElementById('mobile-drawer');
        const open = document.getElementById('mobile-menu-btn');
        const close = document.getElementById('mobile-drawer-close');
        const backdrop = document.getElementById('mobile-drawer-backdrop');
        if (!drawer || !open) return;

        const show = () => {
          drawer.classList.remove('hidden');
          open.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          drawer.querySelector<HTMLElement>('a, button')?.focus();
        };
        const hide = () => {
          drawer.classList.add('hidden');
          open.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          open.focus();
        };

        if (open.dataset.bound !== 'true') {
          open.dataset.bound = 'true';
          open.addEventListener('click', show);
          close?.addEventListener('click', hide);
          backdrop?.addEventListener('click', hide);
          drawer.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') hide();
          });
        }
      }

      /* -------------------------------------------------------------- diagram */
      let mermaidRenderBatch = 0;
      async function rerenderMermaid() {
        const elements = document.querySelectorAll<HTMLElement>('.mermaid');
        if (elements.length === 0) return;
        const isDark = root.getAttribute('data-theme') !== 'light';
        try {
          mermaid.initialize({
            startOnLoad: false,
            theme: isDark ? 'dark' : 'neutral',
            fontFamily: 'Inter Variable, Inter, sans-serif',
            securityLevel: 'loose',
            flowchart: {
              htmlLabels: true,
              useMaxWidth: true,
            },
            sequence: {
              useMaxWidth: true,
            },
            themeVariables: isDark
              ? {
                  darkMode: true,
                  background: '#13131b',
                  mainBkg: '#1c1c27',
                  primaryColor: '#1c1c27',
                  primaryTextColor: '#f4f2ed',
                  primaryBorderColor: '#3a3a4c',
                  lineColor: '#807d8c',
                  secondaryColor: '#1b1b25',
                  tertiaryColor: '#0d0d13',
                  nodeBorder: '#3a3a4c',
                  nodeTextColor: '#f4f2ed',
                  clusterBkg: '#14141e',
                  clusterBorder: '#3a3a4c',
                  defaultLinkColor: '#807d8c',
                  titleColor: '#f4f2ed',
                  edgeLabelBackground: '#13131b',
                  actorBorder: '#3a3a4c',
                  actorBkg: '#1c1c27',
                  actorTextColor: '#f4f2ed',
                  actorLineColor: '#807d8c',
                  signalColor: '#f4f2ed',
                  signalTextColor: '#f4f2ed',
                  labelBoxBkgColor: '#1c1c27',
                  labelBoxBorderColor: '#3a3a4c',
                  labelTextColor: '#f4f2ed',
                  loopTextColor: '#f4f2ed',
                  noteBorderColor: '#3a3a4c',
                  noteBkgColor: '#1c1c27',
                  noteTextColor: '#f4f2ed',
                }
              : {
                  darkMode: false,
                  background: '#ffffff',
                  mainBkg: '#f4f1e9',
                  primaryColor: '#f4f1e9',
                  primaryTextColor: '#1b1b22',
                  primaryBorderColor: '#d8d1c3',
                  lineColor: '#7d7a82',
                  secondaryColor: '#ece7dd',
                  tertiaryColor: '#fbfaf7',
                  nodeBorder: '#d8d1c3',
                  nodeTextColor: '#1b1b22',
                  clusterBkg: '#faf8f5',
                  clusterBorder: '#d8d1c3',
                  defaultLinkColor: '#7d7a82',
                  titleColor: '#1b1b22',
                  edgeLabelBackground: '#ffffff',
                  actorBorder: '#d8d1c3',
                  actorBkg: '#f4f1e9',
                  actorTextColor: '#1b1b22',
                  actorLineColor: '#7d7a82',
                  signalColor: '#1b1b22',
                  signalTextColor: '#1b1b22',
                  labelBoxBkgColor: '#ffffff',
                  labelBoxBorderColor: '#d8d1c3',
                  labelTextColor: '#1b1b22',
                  loopTextColor: '#1b1b22',
                  noteBorderColor: '#d8d1c3',
                  noteBkgColor: '#fff9e6',
                  noteTextColor: '#1b1b22',
                },
          });
        } catch (error) {
          console.warn('Mermaid theme update failed', error);
        }

        mermaidRenderBatch += 1;
        const currentBatch = mermaidRenderBatch;

        for (let i = 0; i < elements.length; i++) {
          if (currentBatch !== mermaidRenderBatch) return;
          const element = elements[i];
          const figure = element.closest('.mermaid-figure');
          const source = element.dataset.mermaidSource;
          if (!source) continue;

          const id = `mermaid-svg-${currentBatch}-${i}`;
          try {
            const { svg, bindFunctions } = await mermaid.render(id, source);
            if (currentBatch !== mermaidRenderBatch) return;
            element.innerHTML = svg;
            if (typeof bindFunctions === 'function') {
              bindFunctions(element);
            }
            figure?.classList.add('is-rendered');
            figure?.classList.remove('has-error');
          } catch (renderError) {
            if (currentBatch !== mermaidRenderBatch) return;
            console.warn(`Mermaid render failed for diagram ${i}:`, renderError);
            const stray = document.getElementById(id) || document.getElementById(`d${id}`);
            if (stray) stray.remove();
            element.innerHTML = `<div class="mermaid-error"><p class="font-medium text-xs">Diagram render notice</p><p class="text-[0.7rem] text-obs-text-muted mt-0.5">Could not render diagram preview.</p></div>`;
            figure?.classList.remove('is-rendered');
            figure?.classList.add('has-error');
            const details = figure?.querySelector<HTMLDetailsElement>('.mermaid-source');
            if (details) details.open = true;
          }
        }
      }

      function enhanceDiagrams() {
        const lightbox = document.getElementById('diagram-lightbox');
        const content = document.getElementById('lightbox-content');
        const close = document.getElementById('close-lightbox-btn');
        if (lightbox && content && close && close.dataset.bound !== 'true') {
          close.dataset.bound = 'true';
          const hide = () => {
            lightbox.classList.add('hidden');
            lightbox.classList.remove('flex');
            content.innerHTML = '';
          };
          close.addEventListener('click', hide);
          lightbox.addEventListener('click', (event) => {
            if (event.target === lightbox) hide();
          });
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && !lightbox.classList.contains('hidden')) hide();
          });
        }

        document.querySelectorAll('.mermaid-container').forEach((container) => {
          const figure = container.closest('.mermaid-figure');
          if (!figure || figure.querySelector('.diagram-expand-btn')) return;
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'diagram-expand-btn';
          button.textContent = 'Expand diagram';
          button.addEventListener('click', () => {
            if (!lightbox || !content) return;
            content.innerHTML = container.innerHTML;
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
          });
          figure.appendChild(button);
        });
      }

      /* ---------------------------------------------------------- code copy */
      function enhanceCodeBlocks() {
        document.querySelectorAll<HTMLElement>('.obsidian-prose pre').forEach((pre) => {
          if (pre.querySelector('.copy-code-btn')) return;
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'copy-code-btn';
          button.textContent = 'Copy';
          button.setAttribute('aria-label', 'Copy code to clipboard');
          button.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.innerText ?? pre.innerText;
            try {
              await navigator.clipboard.writeText(code);
              button.textContent = 'Copied';
              window.setTimeout(() => {
                button.textContent = 'Copy';
              }, 1800);
            } catch {
              button.textContent = 'Failed';
            }
          });
          pre.appendChild(button);
        });
      }

      /* ---------------------------------------------------- pins and recents */
      function setupPinsAndRecents() {
        const path = window.location.pathname.replace(/\/+$/, '') || '/';
        const pageTitle = document.title.split(' — ')[0];

        try {
          if (path !== '/' && !['/search', '/graph', '/library', '/paths', '/tags'].includes(path)) {
            const recents = JSON.parse(localStorage.getItem('obsidian-recent-pages') || '[]');
            const next = recents.filter((item: { slug: string }) => item.slug !== path);
            next.unshift({ title: pageTitle, slug: path });
            localStorage.setItem('obsidian-recent-pages', JSON.stringify(next.slice(0, 10)));
            window.dispatchEvent(new CustomEvent('obsidian:recents-updated'));
          }
        } catch {
          /* ignore */
        }

        const button = document.getElementById('pin-page-btn') as HTMLButtonElement | null;
        if (!button || button.dataset.bound === 'true') return;
        button.dataset.bound = 'true';
        const slug = button.dataset.slug || path;
        const title = button.dataset.title || pageTitle;
        const domain = button.dataset.domain || '';
        const label = button.querySelector<HTMLElement>('.pin-text');

        const sync = () => {
          try {
            const pins = JSON.parse(localStorage.getItem('obsidian-pinned-pages') || '[]');
            const pinned = pins.some((item: { slug: string }) => item.slug === slug);
            button.setAttribute('aria-pressed', String(pinned));
            button.classList.toggle('text-obs-gold', pinned);
            button.classList.toggle('border-obs-gold/50', pinned);
            if (label) label.textContent = pinned ? 'Pinned' : 'Pin';
          } catch {
            /* ignore */
          }
        };

        button.addEventListener('click', () => {
          try {
            const pins = JSON.parse(localStorage.getItem('obsidian-pinned-pages') || '[]');
            const index = pins.findIndex((item: { slug: string }) => item.slug === slug);
            if (index >= 0) pins.splice(index, 1);
            else pins.push({ title, slug, domain });
            localStorage.setItem('obsidian-pinned-pages', JSON.stringify(pins));
            sync();
            window.dispatchEvent(new CustomEvent('obsidian:pins-updated'));
          } catch {
            /* ignore */
          }
        });

        sync();
      }

      /* ------------------------------------------------------------- anchors */
      function scrollToHash() {
        const hash = decodeURIComponent(window.location.hash.slice(1));
        if (!hash) return;
        const target = document.getElementById(hash);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }
        const normalized = hash.toLowerCase().replace(/[^a-z0-9]/g, '');
        for (const heading of document.querySelectorAll<HTMLElement>(
          '.obsidian-prose h1, .obsidian-prose h2, .obsidian-prose h3, .obsidian-prose h4'
        )) {
          const id = heading.id.toLowerCase().replace(/[^a-z0-9]/g, '');
          if (id && (id.includes(normalized) || normalized.includes(id))) {
            heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
            break;
          }
        }
      }

      /* --------------------------------------------------------- shortcuts */
      function setupShortcuts() {
        if (document.body.dataset.shortcutsBound === 'true') return;
        document.body.dataset.shortcutsBound = 'true';
        window.addEventListener('keydown', (event) => {
          const target = event.target as HTMLElement;
          const typing = ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) || target.isContentEditable;
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            window.dispatchEvent(new CustomEvent('obsidian:open-search'));
            return;
          }
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'b') {
            if (!typing) {
              event.preventDefault();
              toggleSidebar();
            }
            return;
          }
          if (typing || event.metaKey || event.ctrlKey || event.altKey) return;
          if (event.key === '/') {
            event.preventDefault();
            const filterInput = document.querySelector<HTMLInputElement>(
              '#left-sidebar input[data-sidebar-filter="true"]'
            );
            const isFolded = root.classList.contains('sidebar-folded');
            if (filterInput && !isFolded && window.innerWidth >= 768) {
              filterInput.focus();
              filterInput.select();
            } else {
              window.dispatchEvent(new CustomEvent('obsidian:open-search'));
            }
          } else if (event.key === '[' || event.key === '\\') {
            event.preventDefault();
            toggleSidebar();
          } else if (event.key.toLowerCase() === 'w') {
            document.getElementById('reading-width-btn')?.click();
          } else if (event.key.toLowerCase() === 'z') {
            document.getElementById('reading-mode-btn')?.click();
          } else if (event.key.toLowerCase() === 'g') {
            window.location.href = '/graph';
          }
        });
      }

      function init() {
        setupTheme();
        setupSidebar();
        setupTheoryWidth();
        setupReadingMode();
        setupDrawer();
        setupPinsAndRecents();
        setupShortcuts();
        enhanceCodeBlocks();
        enhanceDiagrams();
        rerenderMermaid();
        updateProgress();
        scrollToHash();
        const backToTop = document.getElementById('back-to-top');
        if (backToTop && backToTop.dataset.bound !== 'true') {
          backToTop.dataset.bound = 'true';
          backToTop.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      }

      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('hashchange', scrollToHash);
      window.addEventListener('resize', updateProgress, { passive: true });
      document.addEventListener('astro:after-swap', init);
      init();
    </script>
  </body>
</html>
