---
import '../styles/global.css';
import '../styles/markdown.css';
import Header from '../components/Header.astro';
import SidebarTree from '../components/SidebarTree';
import TableOfContents from '../components/TableOfContents';
import BacklinksPanel from '../components/BacklinksPanel';
import CommandPalette from '../components/CommandPalette';
import type { DocMetadata, HeadingItem, BacklinkItem, OutgoingLinkItem, NavigationNode } from '../lib/types';
import { DOMAIN_COLORS, DOMAIN_TITLES } from '../lib/content';
import { Clock, Star, ArrowLeft, ArrowRight, BookOpen, Layers, Bookmark, Check } from 'lucide-react';

interface Props {
  title: string;
  description?: string;
  doc?: DocMetadata;
  headings?: HeadingItem[];
  backlinks?: BacklinkItem[];
  outgoing?: OutgoingLinkItem[];
  navigation: NavigationNode[];
  prevDoc?: { title: string; slug: string } | null;
  nextDoc?: { title: string; slug: string } | null;
}

const {
  title,
  description = 'Complete preparation kit for Java technical interviews at top tech companies.',
  doc,
  headings = [],
  backlinks = [],
  outgoing = [],
  navigation,
  prevDoc,
  nextDoc,
} = Astro.props;

const currentSlug = doc?.slug || Astro.url.pathname;
const breadcrumbs = doc
  ? [
      { title: doc.domainTitle, slug: doc.domain === 'root' ? '/' : `/${doc.domain}` },
      { title: doc.categoryTitle, slug: doc.slug },
    ]
  : [];

const domainColor = doc ? DOMAIN_COLORS[doc.domain] : null;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title ? `${title} — Java Masterclass` : 'Java Masterclass — Obsidian Knowledge Platform'} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`https://java-masterclass.dev${currentSlug}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title ? `${title} — Java Masterclass` : 'Java Masterclass — Obsidian Knowledge Platform'}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" />

    <!-- Theme initialization script (prevents FOUC) -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    </script>
  </head>

  <body class="bg-obs-canvas text-obs-text-secondary antialiased transition-colors selection:bg-obs-accent/20 selection:text-obs-accent">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content-wrapper"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-obs-accent focus:px-4 focus:py-2 focus:text-white focus:shadow-xl focus:outline-none"
    >
      Skip to content
    </a>

    <!-- Top Reading Progress Bar -->
    <div id="reading-progress" class="fixed top-0 left-0 z-50 h-0.5 bg-obs-accent w-0 transition-all duration-75"></div>

    <!-- App Header -->
    <Header breadcrumbs={breadcrumbs} />

    <!-- Three-Pane App Container -->
    <div class="flex min-h-[calc(100vh-3.5rem)] w-full">
      <!-- Left Sidebar: Explorer Tree -->
      <aside
        id="left-sidebar"
        class="hidden md:block w-72 shrink-0 border-r border-obs-border bg-obs-sidebar overflow-hidden sticky top-14 h-[calc(100vh-3.5rem)]"
      >
        <SidebarTree client:load navigation={navigation} currentSlug={currentSlug} />
      </aside>

      <!-- Center Pane: Main Content Canvas -->
      <main id="main-content-wrapper" class="flex-1 min-w-0 px-4 py-8 md:px-10 lg:px-12 max-w-4xl mx-auto focus:outline-none" tabindex="-1">
        <!-- Article Header Card -->
        {doc && (
          <div class="mb-8 rounded-xl border border-obs-border bg-obs-sidebar/60 p-6 backdrop-blur-sm shadow-sm space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <div class="flex items-center gap-2">
                <span
                  class="rounded-full px-2.5 py-0.5 font-semibold text-[11px] border"
                  style={{
                    backgroundColor: domainColor?.bg,
                    color: domainColor?.text,
                    borderColor: domainColor?.border,
                  }}
                >
                  {doc.domainTitle}
                </span>
                <span class="text-obs-text-muted font-mono">/</span>
                <span class="text-obs-text-muted font-medium">{doc.categoryTitle}</span>
              </div>

              <div class="flex items-center gap-3 text-obs-text-muted">
                <!-- Pin / Favorite Page Button -->
                <button
                  id="pin-page-btn"
                  data-slug={doc.slug}
                  data-title={doc.title}
                  data-domain={doc.domainTitle}
                  class="flex items-center gap-1.5 rounded border border-obs-border bg-obs-surface px-2 py-1 text-[11px] text-obs-text-secondary hover:border-obs-accent/50 hover:text-obs-accent transition-colors"
                  title="Pin this page to favorites"
                >
                  <Star className="h-3.5 w-3.5 star-icon" />
                  <span class="pin-text hidden sm:inline">Pin</span>
                </button>

                <div class="flex items-center gap-1.5" title="Estimated reading time">
                  <Clock className="h-3.5 w-3.5 text-obs-accent" />
                  <span>{doc.readingTimeMinutes} min read</span>
                </div>

                {doc.lastUpdated && (
                  <span class="text-[11px] hidden sm:inline">Updated {doc.lastUpdated}</span>
                )}
              </div>
            </div>

            <h1 class="text-3xl font-extrabold tracking-tight text-obs-text-primary md:text-4xl">
              {doc.title}
            </h1>

            <!-- Badges Row -->
            <div class="flex flex-wrap items-center gap-3 pt-2 text-xs border-t border-obs-border/50">
              {doc.level && (
                <div class="flex items-center gap-1.5 text-obs-text-secondary">
                  <span class="text-obs-text-muted">Level:</span>
                  <span class="font-medium text-obs-text-primary">{doc.level}</span>
                </div>
              )}
              {doc.interviewFrequency && (
                <div class="flex items-center gap-1.5 text-amber-400 font-medium">
                  <span class="text-obs-text-muted">Frequency:</span>
                  <span>{doc.interviewFrequency}</span>
                </div>
              )}
              {doc.prerequisites && (
                <div class="flex items-center gap-1.5 text-obs-text-muted text-[11px] w-full mt-1">
                  <span class="font-semibold text-obs-text-secondary">Prerequisites:</span>
                  <span class="truncate">{doc.prerequisites}</span>
                </div>
              )}
            </div>
          </div>
        )}

        <!-- Markdown Document Prose -->
        <article class="obsidian-prose">
          <slot />
        </article>

        <!-- Previous & Next Navigation Cards -->
        {(prevDoc || nextDoc) && (
          <div class="mt-14 pt-8 border-t border-obs-border grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prevDoc ? (
              <a
                href={prevDoc.slug}
                class="group flex flex-col p-4 rounded-xl border border-obs-border bg-obs-sidebar hover:border-obs-accent/50 hover:bg-obs-hover transition-colors"
              >
                <span class="flex items-center gap-1 text-[11px] font-semibold text-obs-text-muted uppercase tracking-wider group-hover:text-obs-accent">
                  <ArrowLeft className="h-3 w-3" /> Previous Topic
                </span>
                <span class="mt-1 font-semibold text-sm text-obs-text-primary truncate">
                  {prevDoc.title}
                </span>
              </a>
            ) : <div />}

            {nextDoc && (
              <a
                href={nextDoc.slug}
                class="group flex flex-col items-end text-right p-4 rounded-xl border border-obs-border bg-obs-sidebar hover:border-obs-accent/50 hover:bg-obs-hover transition-colors"
              >
                <span class="flex items-center gap-1 text-[11px] font-semibold text-obs-text-muted uppercase tracking-wider group-hover:text-obs-accent">
                  Next Topic <ArrowRight className="h-3 w-3" />
                </span>
                <span class="mt-1 font-semibold text-sm text-obs-text-primary truncate">
                  {nextDoc.title}
                </span>
              </a>
            )}
          </div>
        )}
      </main>

      <!-- Right Sidebar: On-page Table of Contents & Backlinks Panel -->
      <aside
        id="right-sidebar"
        class="hidden xl:block w-72 shrink-0 border-l border-obs-border bg-obs-sidebar p-5 overflow-y-auto sticky top-14 h-[calc(100vh-3.5rem)] space-y-6"
      >
        <TableOfContents client:idle headings={headings} />
        <BacklinksPanel client:idle backlinks={backlinks} outgoing={outgoing} />
      </aside>
    </div>

    <!-- Global Command Palette Island -->
    <CommandPalette client:idle />

    <!-- Fullscreen Diagram Lightbox Modal -->
    <div id="diagram-lightbox" class="fixed inset-0 z-50 hidden bg-black/90 p-4 backdrop-blur-md flex flex-col items-center justify-center">
      <div class="flex items-center justify-between w-full max-w-5xl px-4 py-2 text-white">
        <span class="text-xs font-mono text-obs-text-muted">Fullscreen Architecture Diagram View</span>
        <button id="close-lightbox-btn" class="rounded bg-obs-surface p-1.5 hover:bg-obs-hover text-white text-xs">
          ✕ Close
        </button>
      </div>
      <div id="lightbox-content" class="w-full max-w-5xl flex-1 flex items-center justify-center p-4 overflow-auto">
      </div>
    </div>

    <!-- Client enhancements script -->
    <script>
      // Reading progress bar
      function updateReadingProgress() {
        const bar = document.getElementById('reading-progress');
        if (!bar) return;
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight <= 0) {
          bar.style.width = '0%';
          return;
        }
        const progress = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
        bar.style.width = `${progress}%`;
      }
      window.addEventListener('scroll', updateReadingProgress, { passive: true });

      // Copy code button enhancement
      function enhanceCodeBlocks() {
        document.querySelectorAll('pre').forEach((pre) => {
          if (pre.querySelector('.copy-code-btn')) return;

          const btn = document.createElement('button');
          btn.className = 'copy-code-btn absolute top-2 right-2 flex items-center gap-1 rounded bg-obs-surface px-2 py-1 text-[10px] font-mono text-obs-text-muted border border-obs-border hover:bg-obs-hover hover:text-obs-text-primary transition-colors';
          btn.innerHTML = '<span>Copy</span>';

          btn.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.innerText || pre.innerText;
            try {
              await navigator.clipboard.writeText(code);
              btn.innerHTML = '<span class="text-emerald-400 font-semibold">Copied!</span>';
              setTimeout(() => {
                btn.innerHTML = '<span>Copy</span>';
              }, 2000);
            } catch (err) {
              btn.innerText = 'Failed';
            }
          });

          pre.classList.add('relative');
          pre.appendChild(btn);
        });
      }

      // Copy link on headings enhancement
      function enhanceHeadings() {
        document.querySelectorAll('.obsidian-prose h2, .obsidian-prose h3, .obsidian-prose h4').forEach((heading) => {
          if (heading.querySelector('.heading-anchor-btn')) return;
          if (!heading.id) return;

          const btn = document.createElement('button');
          btn.className = 'heading-anchor-btn ml-2 text-obs-text-muted hover:text-obs-accent font-normal text-sm opacity-60 hover:opacity-100 transition-opacity';
          btn.innerHTML = '#';
          btn.title = 'Copy link to this section';

          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
            try {
              await navigator.clipboard.writeText(url);
              btn.innerHTML = '✓';
              setTimeout(() => {
                btn.innerHTML = '#';
              }, 1500);
            } catch (err) {}
          });

          heading.appendChild(btn);
        });
      }

      // Fullscreen diagram lightbox enhancement
      function enhanceDiagrams() {
        const lightbox = document.getElementById('diagram-lightbox');
        const lightboxContent = document.getElementById('lightbox-content');
        const closeBtn = document.getElementById('close-lightbox-btn');
        if (!lightbox || !lightboxContent || !closeBtn) return;

        closeBtn.onclick = () => lightbox.classList.add('hidden');
        lightbox.onclick = (e) => {
          if (e.target === lightbox) lightbox.classList.add('hidden');
        };

        document.querySelectorAll('.mermaid-container').forEach((container) => {
          if (container.querySelector('.diagram-expand-btn')) return;

          const btn = document.createElement('button');
          btn.className = 'diagram-expand-btn mt-2 inline-flex items-center gap-1 rounded bg-obs-surface px-2.5 py-1 text-[11px] text-obs-text-muted border border-obs-border hover:text-obs-accent hover:border-obs-accent/50 transition-colors';
          btn.innerHTML = '🔍 Fullscreen Diagram';

          btn.addEventListener('click', () => {
            lightboxContent.innerHTML = container.innerHTML;
            lightbox.classList.remove('hidden');
          });

          container.appendChild(btn);
        });
      }

      // Pinned and Recently viewed notes tracker
      function setupPinnedAndRecent() {
        const path = window.location.pathname;
        const pageTitle = document.title.replace(' — Java Masterclass', '');

        // 1. Record recently viewed page
        try {
          if (path && path !== '/' && !path.includes('/search') && !path.includes('/graph')) {
            let recents = JSON.parse(localStorage.getItem('obsidian-recent-pages') || '[]');
            recents = recents.filter((r) => r.slug !== path);
            recents.unshift({ title: pageTitle, slug: path });
            if (recents.length > 8) recents.pop();
            localStorage.setItem('obsidian-recent-pages', JSON.stringify(recents));
            window.dispatchEvent(new CustomEvent('obsidian:recents-updated'));
          }
        } catch (e) {}

        // 2. Pin page button
        const pinBtn = document.getElementById('pin-page-btn');
        if (pinBtn) {
          const slug = pinBtn.getAttribute('data-slug') || path;
          const title = pinBtn.getAttribute('data-title') || pageTitle;
          const domain = pinBtn.getAttribute('data-domain') || '';

          function updatePinUI() {
            try {
              const pins = JSON.parse(localStorage.getItem('obsidian-pinned-pages') || '[]');
              const isPinned = pins.some((p) => p.slug === slug);
              const text = pinBtn.querySelector('.pin-text');
              const icon = pinBtn.querySelector('.star-icon');
              if (isPinned) {
                pinBtn.classList.add('text-amber-400', 'border-amber-400/50');
                if (text) text.textContent = 'Pinned';
              } else {
                pinBtn.classList.remove('text-amber-400', 'border-amber-400/50');
                if (text) text.textContent = 'Pin';
              }
            } catch (e) {}
          }

          pinBtn.addEventListener('click', () => {
            try {
              let pins = JSON.parse(localStorage.getItem('obsidian-pinned-pages') || '[]');
              const index = pins.findIndex((p) => p.slug === slug);
              if (index >= 0) {
                pins.splice(index, 1);
              } else {
                pins.push({ title, slug, domain });
              }
              localStorage.setItem('obsidian-pinned-pages', JSON.stringify(pins));
              updatePinUI();
              window.dispatchEvent(new CustomEvent('obsidian:pins-updated'));
            } catch (e) {}
          });

          updatePinUI();
        }
      }

      // Fuzzy anchor scroll fallback
      function handleAnchorScroll() {
        const hash = window.location.hash.slice(1);
        if (!hash) return;
        const target = document.getElementById(hash);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        } else {
          const cleanHash = hash.toLowerCase().replace(/[^a-z0-9]/g, '');
          const headings = document.querySelectorAll('h1, h2, h3, h4, h5, h6');
          for (const h of headings) {
            const hClean = h.id.toLowerCase().replace(/[^a-z0-9]/g, '');
            if (hClean && (hClean.includes(cleanHash) || cleanHash.includes(hClean))) {
              h.scrollIntoView({ behavior: 'smooth' });
              break;
            }
          }
        }
      }

      window.addEventListener('hashchange', handleAnchorScroll);
      if (window.location.hash) {
        setTimeout(handleAnchorScroll, 200);
      }

      function initAll() {
        enhanceCodeBlocks();
        enhanceHeadings();
        enhanceDiagrams();
        setupPinnedAndRecent();
        handleAnchorScroll();
      }

      initAll();
      document.addEventListener('astro:after-swap', initAll);
    </script>
  </body>
</html>
