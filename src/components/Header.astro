---
import {
  BookOpen,
  Command,
  Eye,
  GitBranch,
  Library,
  Menu,
  Moon,
  Search,
  Sun,
  Waypoints,
} from 'lucide-react';

interface Props {
  breadcrumbs?: { title: string; slug: string }[];
}

const { breadcrumbs = [] } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header
  class="sticky top-0 z-40 flex h-[var(--obs-header-height)] w-full items-center justify-between gap-3 border-b border-obs-border bg-obs-canvas/85 px-3 backdrop-blur-xl md:px-4"
>
  <div class="flex min-w-0 items-center gap-2.5">
    <button
      id="mobile-menu-btn"
      type="button"
      class="icon-btn md:hidden"
      aria-label="Open navigation menu"
      aria-controls="mobile-drawer"
      aria-expanded="false"
    >
      <Menu className="h-4 w-4" />
    </button>

    <a
      href="/"
      class="group flex shrink-0 items-center gap-2 font-semibold text-obs-text-primary"
      aria-label="Java Masterclass home"
    >
      <span
        class="relative flex h-8 w-8 items-center justify-center rounded-lg border border-obs-accent/35 bg-obs-accent/10 text-obs-accent shadow-sm transition-colors group-hover:border-obs-accent/60"
      >
        <BookOpen className="h-4 w-4" />
        <span class="absolute -right-0.5 -top-0.5 h-1.5 w-1.5 rounded-full bg-obs-emerald ring-2 ring-obs-canvas"></span>
      </span>
      <span class="hidden flex-col leading-none sm:flex">
        <span class="text-[0.82rem] font-bold tracking-tight">Java Masterclass</span>
        <span class="mt-0.5 text-[0.58rem] font-medium uppercase tracking-[0.18em] text-obs-text-muted">
          Knowledge base
        </span>
      </span>
    </a>

    {breadcrumbs.length > 0 && (
      <nav
        aria-label="Breadcrumb"
        class="hidden min-w-0 items-center gap-1 text-[0.72rem] text-obs-text-muted lg:flex"
      >
        <span aria-hidden="true" class="text-obs-border">/</span>
        {breadcrumbs.map((crumb, index) => (
          <span class="flex min-w-0 items-center gap-1">
            {index > 0 && <span aria-hidden="true" class="text-obs-border">/</span>}
            <a
              href={crumb.slug}
              class="max-w-[13rem] truncate rounded px-0.5 transition-colors hover:text-obs-accent"
              aria-current={crumb.slug === pathname ? 'page' : undefined}
            >
              {crumb.title}
            </a>
          </span>
        ))}
      </nav>
    )}
  </div>

  <div class="flex shrink-0 items-center gap-1.5">
    <button
      id="open-command-palette-btn"
      type="button"
      class="flex h-[2.15rem] items-center gap-2 rounded-lg border border-obs-border bg-obs-surface px-2.5 text-xs text-obs-text-muted transition-colors hover:border-obs-accent/40 hover:text-obs-text-primary"
      aria-label="Search the knowledge base"
    >
      <Search className="h-3.5 w-3.5 text-obs-accent" />
      <span class="hidden sm:inline">Search</span>
      <kbd class="ml-1 hidden items-center gap-0.5 text-[0.62rem] md:inline-flex">
        <Command className="h-2.5 w-2.5" />K
      </kbd>
    </button>

    <a
      href="/library"
      class="hidden h-[2.15rem] items-center gap-1.5 rounded-lg px-2.5 text-xs font-medium text-obs-text-muted transition-colors hover:bg-obs-surface hover:text-obs-text-primary lg:flex"
      aria-label="Browse the complete library"
    >
      <Library className="h-3.5 w-3.5" />
      Library
    </a>
    <a
      href="/paths"
      class="hidden h-[2.15rem] items-center gap-1.5 rounded-lg px-2.5 text-xs font-medium text-obs-text-muted transition-colors hover:bg-obs-surface hover:text-obs-text-primary lg:flex"
      aria-label="View learning paths"
    >
      <Waypoints className="h-3.5 w-3.5" />
      Paths
    </a>
    <a
      href="/graph"
      class="hidden h-[2.15rem] items-center gap-1.5 rounded-lg px-2.5 text-xs font-medium text-obs-text-muted transition-colors hover:bg-obs-surface hover:text-obs-text-primary xl:flex"
      aria-label="Open the knowledge graph"
    >
      <GitBranch className="h-3.5 w-3.5" />
      Graph
    </a>

    <span class="mx-0.5 hidden h-5 w-px bg-obs-border sm:block" aria-hidden="true"></span>

    <button
      id="reading-mode-btn"
      type="button"
      class="icon-btn hidden sm:inline-flex"
      title="Toggle focus reading mode (Z)"
      aria-label="Toggle focus reading mode"
      aria-pressed="false"
    >
      <Eye className="h-4 w-4" />
    </button>
    <button
      id="theme-toggle-btn"
      type="button"
      class="icon-btn"
      title="Toggle dark and light theme"
      aria-label="Toggle color theme"
    >
      <Sun className="theme-icon theme-icon-light h-4 w-4" />
      <Moon className="theme-icon theme-icon-dark h-4 w-4" />
    </button>
  </div>
</header>
