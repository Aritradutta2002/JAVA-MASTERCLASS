---
import SectionHeading from './SectionHeading.astro';
import { ArrowRight } from 'lucide-react';
interface Path { title: string; description: string; href: string; level: string; weeks: string; hours: string; docs: number; highlight: string; }
interface Props { paths: Path[]; }
const { paths } = Astro.props;
---
<section class="content-section" aria-labelledby="paths-heading">
  <SectionHeading number="02" label="LEARNING PATHS" id="paths-heading" title="Follow the path. Know the why." description="Ordered tracks from fundamentals through production Java. Start with your target and move through verified prerequisites, not a random collection of notes." />
  <div class="mt-8 border-b border-obs-border">{paths.map((path, index) => <article class="grid gap-4 border-t border-obs-border py-6 md:grid-cols-[48px_1fr_auto]"><span class="technical-label text-obs-text-muted">TRACK {String(index + 1).padStart(2, '0')}</span><div><h3 class="m-0 text-lg font-semibold text-obs-text-primary">{path.title}</h3><p class="mt-2 m-0 max-w-2xl text-sm leading-relaxed text-obs-text-secondary">{path.description}</p><div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-obs-text-muted"><span>{path.level}</span><span>{path.docs} chapters</span><span>{path.highlight}</span></div></div><div class="flex items-center justify-between gap-4 md:flex-col md:items-end"><div class="text-right"><p class="m-0 font-mono text-sm text-obs-text-primary">{path.weeks}</p><p class="mb-1 mt-0 text-micro technical-label text-obs-text-muted">{path.hours}</p></div><a href={path.href} class="btn btn-secondary h-9 px-3 text-xs">Explore path <ArrowRight className="h-3.5 w-3.5" /></a></div></article>)}</div>
</section>
