---
import fs from 'node:fs';
import path from 'node:path';
import { FileCode2, Copy, Check, Terminal, ChevronDown } from 'lucide-react';

interface Props {
  filePaths: string[];
}

const { filePaths = [] } = Astro.props;

function escapeHtml(str: string) {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function highlightJavaCode(code: string) {
  const lines = code.split('\n');
  let inBlockComment = false;

  return lines.map((line, idx) => {
    let result = '';
    let rest = line;

    if (inBlockComment) {
      const endIdx = rest.indexOf('*/');
      if (endIdx !== -1) {
        result += `<span class="text-obs-text-muted italic opacity-75">${escapeHtml(rest.slice(0, endIdx + 2))}</span>`;
        rest = rest.slice(endIdx + 2);
        inBlockComment = false;
      } else {
        return {
          lineNum: idx + 1,
          html: `<span class="text-obs-text-muted italic opacity-75">${escapeHtml(rest)}</span>`,
        };
      }
    }

    const tokenRegex =
      /(\/\*[\s\S]*?\*\/|\/\*[\s\S]*)|(\/\/[^\n]*)|("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')|(@[A-Za-z0-9_]+)|\b(package|import|public|private|protected|class|interface|record|enum|extends|implements|static|final|abstract|synchronized|volatile|transient|native|strictfp|void|return|if|else|switch|case|default|break|continue|for|while|do|try|catch|finally|throw|throws|new|this|super|instanceof|assert|var|yield|sealed|permits|non-sealed)\b|\b(true|false|null)\b|\b(int|long|double|float|boolean|byte|char|short|String|Integer|Long|Boolean|Double|Float|Byte|Character|Short|List|Map|Set|Queue|Deque|Optional|CompletableFuture|Thread|Stream|Object|Arrays|Collections|Math|System|Override)\b|\b(\d+[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d+)?(?:[fFdDlL])?)\b/g;

    let lastIndex = 0;
    let match: RegExpExecArray | null;

    while ((match = tokenRegex.exec(rest)) !== null) {
      result += escapeHtml(rest.slice(lastIndex, match.index));
      const [, blockComment, lineComment, str, annotation, keyword, boolNull, type, num] = match;

      if (blockComment) {
        if (!blockComment.endsWith('*/')) {
          inBlockComment = true;
        }
        result += `<span class="text-obs-text-muted italic opacity-75">${escapeHtml(blockComment)}</span>`;
      } else if (lineComment) {
        result += `<span class="text-obs-text-muted italic opacity-75">${escapeHtml(lineComment)}</span>`;
      } else if (str) {
        result += `<span class="text-obs-success-text font-normal">${escapeHtml(str)}</span>`;
      } else if (annotation) {
        result += `<span class="text-obs-warning-text font-medium">${escapeHtml(annotation)}</span>`;
      } else if (keyword) {
        result += `<span class="text-obs-accent-hover font-semibold">${escapeHtml(keyword)}</span>`;
      } else if (boolNull) {
        result += `<span class="text-obs-error-text font-medium">${escapeHtml(boolNull)}</span>`;
      } else if (type) {
        result += `<span class="text-obs-info-text font-medium">${escapeHtml(type)}</span>`;
      } else if (num) {
        result += `<span class="text-obs-warning-text">${escapeHtml(num)}</span>`;
      }
      lastIndex = tokenRegex.lastIndex;
    }

    result += escapeHtml(rest.slice(lastIndex));
    return {
      lineNum: idx + 1,
      html: result,
    };
  });
}

const filesData = filePaths
  .map((relPath) => {
    const fullPath = path.join(process.cwd(), relPath);
    let code = '';
    if (fs.existsSync(fullPath)) {
      code = fs.readFileSync(fullPath, 'utf-8');
    }
    const lines = highlightJavaCode(code);
    return {
      name: path.basename(relPath),
      relPath,
      code,
      lines,
      lineCount: lines.length,
    };
  })
  .filter((f) => f.code.length > 0);
---

{filesData.length > 0 && (
  <div class="my-8 rounded-md border border-obs-border/80 bg-obs-canvas-soft/80 backdrop-blur-sm overflow-hidden shadow-obs-lg ring-1 ring-black/5 dark:ring-white/5 transition-all">
    {/* IDE Window Top Header */}
    <div class="px-4 py-3 border-b border-obs-border/80 bg-obs-sidebar/90 flex flex-wrap items-center justify-between gap-3 select-none">
      <div class="flex items-center gap-3">
        {/* Window controls dots */}
        <div class="flex items-center gap-1.5 opacity-80 hover:opacity-100 transition-opacity">
          <span class="h-3 w-3 rounded-sm bg-[#ff5f56] border border-[#e0443e]/50 inline-block shadow-xs" />
          <span class="h-3 w-3 rounded-sm bg-[#ffbd2e] border border-[#dea123]/50 inline-block shadow-xs" />
          <span class="h-3 w-3 rounded-sm bg-[#27c93f] border border-[#1aab29]/50 inline-block shadow-xs" />
        </div>

        <div class="h-4 w-px bg-obs-border/60 mx-1 hidden sm:block" />

        <div class="flex items-center gap-2">
          <div class="flex h-6 w-6 items-center justify-center rounded-md bg-obs-warning-subtle text-obs-warning-text border border-obs-warning/25">
            <Terminal className="h-3.5 w-3.5" />
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-obs-text-primary">
            Runnable Reference Implementation
          </span>
          <span class="inline-flex items-center px-2 py-0.5 rounded-sm text-micro font-mono font-medium bg-obs-surface border border-obs-border text-obs-text-secondary">
            Java 21 / JVM
          </span>
        </div>
      </div>

      <div class="flex items-center gap-2 text-caption text-obs-text-muted font-mono">
        <span>{filesData.length} source file{filesData.length > 1 ? 's' : ''}</span>
      </div>
    </div>

    {/* File Sections */}
    <div class="divide-y divide-obs-border/70">
      {filesData.map((file, idx) => (
        <details class="group/file" open={idx === 0}>
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-xs font-medium text-obs-text-secondary hover:bg-obs-surface/80 hover:text-obs-text-primary transition-all select-none">
            <div class="flex items-center gap-2.5 min-w-0">
              <FileCode2 className="h-4 w-4 text-obs-warning-text shrink-0" />
              <span class="font-mono text-obs-accent font-semibold truncate">{file.name}</span>
              <span class="text-caption text-obs-text-muted font-mono hidden md:inline truncate">
                {file.relPath}
              </span>
            </div>

            <div class="flex items-center gap-3 shrink-0 ml-2">
              <span class="text-caption font-mono text-obs-text-muted bg-obs-surface/60 px-2 py-0.5 rounded border border-obs-border/40">
                {file.lineCount} lines
              </span>
              <ChevronDown className="h-4 w-4 text-obs-text-muted group-open/file:rotate-180 transition-transform duration-200" />
            </div>
          </summary>

          <div class="relative border-t border-obs-border/50 bg-[#0c0d12] dark:bg-[#090a0f]">
            {/* Copy button & Actions Bar */}
            <div class="absolute top-2.5 right-3 z-10 flex items-center gap-2">
              <button
                type="button"
                data-copy-button
                data-file-index={idx}
                class="copy-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-caption font-medium bg-obs-surface/90 hover:bg-obs-hover border border-obs-border/80 text-obs-text-secondary hover:text-obs-text-primary shadow-sm backdrop-blur-md transition-all active:scale-95"
                title="Copy source code to clipboard"
              >
                <Copy className="h-3.5 w-3.5 text-obs-text-muted copy-icon" />
                <Check className="h-3.5 w-3.5 text-obs-success-text check-icon hidden" />
                <span class="copy-label font-mono">Copy Code</span>
              </button>
            </div>

            {/* Code area with gutter line numbers */}
            <div class="overflow-x-auto text-xs font-mono py-3.5 px-2 leading-relaxed">
              <table class="border-collapse w-full">
                <tbody>
                  {file.lines.map((l) => (
                    <tr class="hover:bg-white/[0.03] transition-colors group/line">
                      <td class="select-none text-right pr-4 pl-2 text-caption font-mono text-obs-text-muted group-hover/line:text-obs-text-muted w-12 align-top border-r border-obs-border/30">
                        {l.lineNum}
                      </td>
                      <td class="pl-4 pr-16 whitespace-pre text-sm font-mono text-obs-text-secondary align-top">
                        <Fragment set:html={l.html || '&nbsp;'} />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* Hidden raw code storage for zero-loss clipboard copying */}
            <textarea
              class="hidden raw-code-storage"
              data-file-index={idx}
              readonly
              aria-hidden="true"
              tabindex={-1}
            >{file.code}</textarea>
          </div>
        </details>
      ))}
    </div>
  </div>
)}

<script>
  function setupCodeCopyButtons() {
    document.querySelectorAll('[data-copy-button]').forEach((btn) => {
      // Remove any prior listener if hot-reloaded
      btn.replaceWith(btn.cloneNode(true));
    });

    document.querySelectorAll<HTMLButtonElement>('[data-copy-button]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const fileIndex = btn.getAttribute('data-file-index');
        const container = btn.closest('details');
        const storage = container?.querySelector<HTMLTextAreaElement>(`textarea.raw-code-storage[data-file-index="${fileIndex}"]`);
        const textToCopy = storage?.value;

        if (!textToCopy) return;

        try {
          await navigator.clipboard.writeText(textToCopy);

          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');
          const label = btn.querySelector('.copy-label');

          if (copyIcon) copyIcon.classList.add('hidden');
          if (checkIcon) checkIcon.classList.remove('hidden');
          if (label) label.textContent = 'Copied!';
          btn.classList.add('border-obs-success/40', 'bg-obs-success-subtle', 'text-obs-success-text');

          setTimeout(() => {
            if (copyIcon) copyIcon.classList.remove('hidden');
            if (checkIcon) checkIcon.classList.add('hidden');
            if (label) label.textContent = 'Copy Code';
            btn.classList.remove('border-obs-success/40', 'bg-obs-success-subtle', 'text-obs-success-text');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code:', err);
        }
      });
    });
  }

  // Setup on initial page load and on Astro page swaps
  setupCodeCopyButtons();
  document.addEventListener('astro:page-load', setupCodeCopyButtons);
</script>
