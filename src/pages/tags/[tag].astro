---
import ObsidianLayout from '../../layouts/ObsidianLayout.astro';
import { buildNavigationTree, getAllDocs, getAllTags } from '../../lib/content';
import { ArrowLeft, ArrowRight, FileText, Tag } from 'lucide-react';
import type { DocMetadata, NavigationNode } from '../../lib/types';

export async function getStaticPaths() {
  const allDocs = getAllDocs();
  const navigation = buildNavigationTree(allDocs);
  const tags = getAllTags(allDocs);

  return tags.map((entry) => ({
    params: { tag: entry.tag },
    props: { tag: entry.tag, docs: entry.docs, navigation },
  }));
}

interface Props {
  tag: string;
  docs: DocMetadata[];
  navigation: NavigationNode[];
}

const { tag, docs, navigation } = Astro.props;

const domains = new Map<string, number>();
for (const doc of docs) {
  domains.set(doc.domainTitle, (domains.get(doc.domainTitle) || 0) + 1);
}
const relatedTags = new Map<string, number>();
for (const doc of docs) {
  for (const item of doc.tags) {
    if (item === tag) continue;
    relatedTags.set(item, (relatedTags.get(item) || 0) + 1);
  }
}
const coTags = [...relatedTags.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 12);

const sortedDocs = [...docs].sort((a, b) => a.title.localeCompare(b.title));
---

<ObsidianLayout
  title={`#${tag}`}
  description={`${docs.length} chapters tagged #${tag} in the Java Masterclass.`}
  navigation={navigation}
  eyebrow={`Tag · ${docs.length} chapters`}
  wide
>
  <div class="not-prose space-y-8">
    <header class="space-y-3 border-b border-obs-border pb-6">
      <a href="/tags" class="inline-flex items-center gap-1.5 text-xs font-medium text-obs-accent hover:underline">
        <ArrowLeft className="h-3 w-3" /> All tags
      </a>
      <div class="flex flex-wrap items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl border border-obs-accent/35 bg-obs-accent/10 text-obs-accent">
          <Tag className="h-5 w-5" />
        </span>
        <div>
          <h1 class="font-serif text-3xl font-bold tracking-tight text-obs-text-primary">#{tag}</h1>
          <p class="mt-0.5 text-xs text-obs-text-muted">
            {docs.length} chapter{docs.length === 1 ? '' : 's'} · {domains.size} domain{domains.size === 1 ? '' : 's'}
          </p>
        </div>
      </div>

      <div class="flex flex-wrap gap-1.5 pt-1">
        {[...domains.entries()].map(([title, count]) => (
          <span class="badge">{title} · {count}</span>
        ))}
      </div>

      {coTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 pt-1">
          <span class="text-[0.62rem] font-bold uppercase tracking-[0.12em] text-obs-text-muted">Also tagged</span>
          {coTags.map(([item, count]) => (
            <a
              href={`/tags/${encodeURIComponent(item)}`}
              class="rounded border border-obs-border-subtle bg-obs-canvas-soft px-1.5 py-0.5 font-mono text-[0.62rem] text-obs-text-muted transition-colors hover:border-obs-accent/40 hover:text-obs-accent"
            >
              #{item} <span class="opacity-60">{count}</span>
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {sortedDocs.map((doc) => (
        <a
          href={doc.slug}
          class="surface-card surface-card-hover group flex flex-col p-4"
        >
          <div class="flex items-center justify-between gap-2 text-[0.62rem] text-obs-text-muted">
            <span class="font-semibold uppercase tracking-wider text-obs-accent/80">{doc.domainTitle}</span>
            {doc.level && <span class="badge">{doc.level}</span>}
          </div>
          <h2 class="mt-2 font-serif text-base font-semibold leading-snug text-obs-text-primary group-hover:text-obs-accent">
            {doc.title}
          </h2>
          {doc.summary && (
            <p class="mt-1.5 line-clamp-3 text-xs leading-relaxed text-obs-text-muted">{doc.summary}</p>
          )}
          <div class="mt-auto flex items-center justify-between border-t border-obs-border-subtle pt-2.5 text-[0.62rem] text-obs-text-muted">
            <span class="inline-flex items-center gap-1">
              <FileText className="h-3 w-3" /> {doc.readingTimeMinutes} min
            </span>
            <span class="inline-flex items-center gap-1 font-semibold text-obs-accent opacity-0 transition-opacity group-hover:opacity-100">
              Read <ArrowRight className="h-3 w-3" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</ObsidianLayout>
