---
import ObsidianLayout from '../../layouts/ObsidianLayout.astro';
import { buildNavigationTree, getAllDocs, getAllTags } from '../../lib/content';
import { Tag, Search } from 'lucide-react';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);
const tagEntries = getAllTags(allDocs);

const totalMentions = tagEntries.reduce((sum, entry) => sum + entry.count, 0);
const taggedDocs = new Set(tagEntries.flatMap((entry) => entry.docs.map((doc) => doc.slug))).size;

const initial = new Map<string, typeof tagEntries>();
for (const entry of tagEntries) {
  const letter = entry.tag.charAt(0).toUpperCase();
  const key = /[A-Z]/.test(letter) ? letter : '#';
  if (!initial.has(key)) initial.set(key, []);
  initial.get(key)!.push(entry);
}

const letters = [...initial.entries()].sort((a, b) => {
  if (a[0] === '#') return 1;
  if (b[0] === '#') return -1;
  return a[0].localeCompare(b[0]);
});

const fmt = new Intl.NumberFormat('en-US');
---

<ObsidianLayout
  title="Tags and concepts"
  description="Browse the Java Masterclass by conceptual tags, technologies, and technical topics."
  navigation={navigation}
  wide
>
  <div class="not-prose space-y-8">
    <header class="space-y-3 border-b border-obs-border pb-6">
      <p class="eyebrow"><Tag className="h-3.5 w-3.5" /> Taxonomy</p>
      <h1 class="font-serif text-3xl font-bold tracking-tight text-obs-text-primary sm:text-4xl">
        Tags and concepts
      </h1>
      <p class="max-w-2xl text-sm leading-relaxed text-obs-text-muted">
        {fmt.format(tagEntries.length)} tags across {fmt.format(taggedDocs)} chapters
        ({fmt.format(totalMentions)} mentions), derived from document structure and technology
        mentions. Select a tag to see every chapter that covers it.
      </p>

      <div class="relative mt-2 flex max-w-xl items-center">
        <Search className="pointer-events-none absolute left-2.5 h-4 w-4 text-obs-accent" />
        <label for="tag-filter" class="sr-only">Filter tags</label>
        <input
          id="tag-filter"
          type="search"
          placeholder="Filter tags…"
          class="w-full rounded-lg border border-obs-border bg-obs-surface py-2 pl-9 pr-3 text-sm text-obs-text-primary placeholder:text-obs-text-muted focus:border-obs-accent focus:outline-none"
        />
      </div>
      <p id="tag-count" class="text-[0.68rem] text-obs-text-muted" aria-live="polite">
        Showing {fmt.format(tagEntries.length)} tags.
      </p>
    </header>

    {letters.map(([letter, entries]) => (
      <section class="tag-letter scroll-mt-24" data-letter={letter} aria-labelledby={`tag-letter-${letter}`}>
        <div class="mb-2 flex items-center gap-2 border-b border-obs-border pb-1">
          <span class="flex h-6 w-6 items-center justify-center rounded-md border border-obs-accent/30 bg-obs-accent/10 font-mono text-[0.7rem] font-bold text-obs-accent">
            {letter}
          </span>
          <h2 id={`tag-letter-${letter}`} class="font-serif text-lg font-bold text-obs-text-primary">
            {letter}
          </h2>
          <span class="ml-auto font-mono text-[0.6rem] text-obs-text-muted">{entries.length}</span>
        </div>
        <div class="flex flex-wrap gap-2">
          {entries.map((entry) => (
            <a
              href={`/tags/${encodeURIComponent(entry.tag)}`}
              data-tag={entry.tag.toLowerCase()}
              class="tag-chip group flex items-center gap-2 rounded-lg border border-obs-border bg-obs-surface px-3 py-1.5 text-[0.72rem] text-obs-text-secondary transition-colors hover:border-obs-accent/45 hover:bg-obs-hover hover:text-obs-text-primary"
            >
              <span class="font-medium group-hover:text-obs-accent">#{entry.tag}</span>
              <span class="rounded-full border border-obs-border bg-obs-canvas px-1.5 py-px font-mono text-[0.6rem] text-obs-text-muted">
                {entry.count}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div id="tag-empty" class="hidden rounded-xl border border-obs-border bg-obs-surface p-10 text-center">
      <p class="text-sm font-semibold text-obs-text-primary">No tags match that filter</p>
      <p class="mt-1 text-xs text-obs-text-muted">Try a shorter term or clear the input.</p>
    </div>
  </div>

  <script>
    const input = document.getElementById('tag-filter') as HTMLInputElement | null;
    const count = document.getElementById('tag-count');
    const empty = document.getElementById('tag-empty');

    function apply() {
      const query = (input?.value || '').trim().toLowerCase();
      let visible = 0;
      document.querySelectorAll<HTMLElement>('.tag-letter').forEach((section) => {
        let letterVisible = 0;
        section.querySelectorAll<HTMLElement>('.tag-chip').forEach((chip) => {
          const show = !query || (chip.dataset.tag || '').includes(query);
          chip.classList.toggle('hidden', !show);
          if (show) letterVisible += 1;
        });
        section.classList.toggle('hidden', letterVisible === 0);
        visible += letterVisible;
      });
      if (count) {
        count.textContent = `Showing ${visible.toLocaleString('en-US')} tag${visible === 1 ? '' : 's'}.`;
      }
      empty?.classList.toggle('hidden', visible !== 0);
    }

    input?.addEventListener('input', apply);
  </script>
</ObsidianLayout>
