---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import PageHeader from '../components/system/PageHeader.astro';
import MetricStrip from '../components/system/MetricStrip.astro';
import { buildNavigationTree, getAllDocs } from '../lib/content';
import { DOMAIN_COLORS, DOMAIN_TITLES } from '../lib/constants';
import {
  ArrowRight,
  CheckCircle2,
  Clock,
  Compass,
  FileText,
  GraduationCap,
  Target,
} from 'lucide-react';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);

interface PathDefinition {
  id: string;
  title: string;
  domain: string;
  weeks: string;
  level: string;
  intro: string;
  outcome: string;
  docs: typeof allDocs;
}

const definitions: Omit<PathDefinition, 'docs'>[] = [
  {
    id: 'java-backend-foundations',
    title: 'Java backend foundations',
    domain: 'core-java',
    weeks: '4 weeks',
    level: 'Beginner → Advanced',
    intro:
      'Build the language and runtime foundation that every Java interview assumes. Read in order: object model, memory, collections, generics, modern Java, concurrency, and design patterns.',
    outcome: 'Explain the JVM memory model, choose the right collection, reason about happens-before, and apply the GoF patterns.',
  },
  {
    id: 'spring-boot-in-production',
    title: 'Spring Boot in production',
    domain: 'spring-boot',
    weeks: '6 weeks',
    level: 'Intermediate → Advanced',
    intro:
      'Follow a request from auto-configuration through MVC, persistence, security, messaging, caching, observability, and deployment.',
    outcome: 'Design, secure, test, and operate a production Spring Boot service, and defend the trade-offs in a design interview.',
  },
  {
    id: 'distributed-systems-and-hld',
    title: 'Distributed systems and HLD',
    domain: 'system-design',
    weeks: '5 weeks',
    level: 'Intermediate → Expert',
    intro:
      'Start with fundamentals and CAP, then move through storage, caching, messaging, APIs, security, observability, and full case studies.',
    outcome: 'Run a structured 45-minute system design interview and justify consistency, partitioning, and failure-handling choices.',
  },
  {
    id: 'interview-algorithms',
    title: 'Interview algorithms',
    domain: 'java-dsa',
    weeks: '8 weeks',
    level: 'Beginner → Advanced',
    intro:
      'Learn the patterns first, then the data structures, then the graph and dynamic-programming masterclasses. Every pattern points to runnable Java.',
    outcome: 'Recognise problem patterns quickly, derive complexity, and implement clean Java solutions under time pressure.',
  },
  {
    id: 'databases-and-caching',
    title: 'Databases and caching',
    domain: 'database-caching',
    weeks: '3 weeks',
    level: 'Intermediate → Advanced',
    intro:
      'Understand what the database actually does: storage engines, B+ trees, query planning, transactions, replication, sharding, and cache correctness.',
    outcome: 'Read an EXPLAIN plan, design an index, reason about isolation, and choose a caching strategy without lying to yourself about consistency.',
  },
];

const paths: PathDefinition[] = definitions.map((definition) => ({
  ...definition,
  docs: allDocs
    .filter((doc) => doc.domain === definition.domain)
    .sort((a, b) => a.filePath.localeCompare(b.filePath, undefined, { numeric: true })),
}));

const totalCurriculumHours = Math.round(
  allDocs.reduce((sum, doc) => sum + doc.readingTimeMinutes, 0) / 60
);

const fmt = new Intl.NumberFormat('en-US');
---

<ObsidianLayout
  title="Learning paths"
  description="Structured Java, Spring Boot, system design, database, and algorithms study plans built from the Java Masterclass."
  navigation={navigation}
  wide
>
  <div class="not-prose space-y-12">
    <!-- Header -->
    <PageHeader eyebrow="02 / ROLE-BASED STUDY TRACKS" title="A deliberate route to depth." description="Choose the outcome you need. Each path starts with your target and moves through verified prerequisites, not a random collection of notes.">
      <MetricStrip metrics={[{ label:'Structured tracks', value:paths.length },{ label:'Core chapters', value:paths.reduce((total,path)=>total+path.docs.length,0) },{ label:'Estimated hours', value:totalCurriculumHours }]} />
    </PageHeader>


    <!-- Path Tracks List -->
    <div class="space-y-16">
      {paths.map((path, pathIndex) => {
        const color = DOMAIN_COLORS[path.domain];
        const totalMinutes = path.docs.reduce((sum, doc) => sum + doc.readingTimeMinutes, 0);
        const hours = Math.round(totalMinutes / 60);

        return (
          <section
            id={path.id}
            class="min-w-0 overflow-hidden scroll-mt-24 rounded-hero border border-obs-border bg-gradient-to-b from-obs-surface/90 to-obs-canvas-soft/60 p-6 shadow-obs transition-all sm:p-8"
            aria-labelledby={`${path.id}-heading`}
          >
            <!-- Track Header -->
            <div class="flex flex-wrap items-start justify-between gap-4 border-b border-obs-border-subtle pb-6">
              <div class="flex items-start gap-4">
                <span
                  class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border font-mono text-base font-extrabold shadow-sm"
                  style={{ backgroundColor: color?.bg, color: color?.text, borderColor: color?.border }}
                >
                  {String(pathIndex + 1).padStart(2, '0')}
                </span>
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <span
                      class="rounded-md border px-2 py-0.5 text-micro font-bold uppercase tracking-[0.12em]"
                      style={{ backgroundColor: color?.bg, color: color?.text, borderColor: color?.border }}
                    >
                      {DOMAIN_TITLES[path.domain] || path.domain}
                    </span>
                    <span class="badge font-mono text-caption">{path.weeks}</span>
                    <span class="badge text-caption">{path.level}</span>
                  </div>

                  <h2 id={`${path.id}-heading`} class="mt-2 text-2xl font-bold tracking-tight text-obs-text-primary sm:text-3xl">
                    {path.title}
                  </h2>

                  <div class="mt-2 flex flex-wrap items-center gap-3 text-xs text-obs-text-muted">
                    <span class="inline-flex items-center gap-1.5 font-medium">
                      <FileText className="h-3.5 w-3.5 text-obs-accent" />
                      {path.docs.length} chapters
                    </span>
                    <span class="text-obs-border">•</span>
                    <span class="inline-flex items-center gap-1.5 font-medium">
                      <Clock className="h-3.5 w-3.5 text-obs-accent" />
                      ~{hours} hrs ({fmt.format(totalMinutes)} min reading time)
                    </span>
                  </div>
                </div>
              </div>

              <a
                href={path.domain === 'java-dsa' ? '/java-dsa' : `/${path.domain}`}
                class="btn btn-secondary shadow-sm"
              >
                <span>Browse domain</span>
                <ArrowRight className="h-3.5 w-3.5" />
              </a>
            </div>

            <!-- Content Grid: Timeline on Left, Strategy/Outcome on Right -->
            <div class="mt-6 grid min-w-0 gap-6 lg:grid-cols-[1fr_20rem]">
              <!-- Sequential Milestone List -->
              <div class="min-w-0 overflow-hidden rounded-2xl border border-obs-border bg-obs-surface/40 p-2 sm:p-4">
                <div class="mb-3 flex items-center justify-between px-2 pt-1">
                  <span class="text-caption font-bold uppercase tracking-[0.14em] text-obs-text-muted">
                    Sequential Milestones
                  </span>
                  <span class="font-mono text-xs text-obs-text-muted">
                    {path.docs.length} chapters
                  </span>
                </div>

                <ol class="space-y-1.5">
                  {path.docs.map((doc, index) => (
                    <li>
                      <a
                        href={doc.slug}
                        class="group flex items-center gap-3.5 rounded-xl border border-transparent px-3 py-2.5 transition-all duration-150 hover:border-obs-border hover:bg-obs-surface hover:shadow-sm"
                      >
                        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg border border-obs-border-subtle bg-obs-canvas-soft font-mono text-caption font-bold text-obs-text-muted transition-colors group-hover:border-obs-accent/40 group-hover:text-obs-accent">
                          {String(index + 1).padStart(2, '0')}
                        </span>

                        <div class="min-w-0 flex-1">
                          <span class="block truncate text-sm font-semibold text-obs-text-primary group-hover:text-obs-accent transition-colors">
                            {doc.title}
                          </span>
                          <span class="block truncate text-caption text-obs-text-muted">
                            {doc.categoryTitle} · {doc.readingTimeMinutes} min
                          </span>
                        </div>

                        {doc.interviewFrequency && (
                          <span class="hidden rounded-full border border-obs-gold/30 bg-obs-gold/10 px-2 py-0.5 text-micro font-semibold text-obs-gold sm:inline-block">
                            {doc.interviewFrequency}
                          </span>
                        )}

                        <ArrowRight className="h-3.5 w-3.5 shrink-0 text-obs-text-muted opacity-0 transition-all duration-150 group-hover:translate-x-0.5 group-hover:opacity-100" />
                      </a>
                    </li>
                  ))}
                </ol>
              </div>

              <!-- Strategy & Outcomes Sticky Column -->
              <aside class="space-y-4">
                <!-- Why this order -->
                <div class="rounded-2xl border border-obs-border bg-obs-surface/60 p-5 shadow-sm">
                  <div class="flex items-center gap-2 text-caption font-bold uppercase tracking-[0.14em] text-obs-accent">
                    <Compass className="h-3.5 w-3.5" />
                    <span>Progression Strategy</span>
                  </div>
                  <p class="mt-2 text-xs leading-relaxed text-obs-text-secondary">
                    {path.intro}
                  </p>
                </div>

                <!-- Verified Outcome -->
                <div class="rounded-2xl border border-obs-border bg-obs-surface/60 p-5 shadow-sm">
                  <div class="flex items-center gap-2 text-caption font-bold uppercase tracking-[0.14em] text-obs-emerald">
                    <Target className="h-3.5 w-3.5" />
                    <span>Target Competency</span>
                  </div>
                  <p class="mt-2 text-xs leading-relaxed text-obs-text-secondary">
                    {path.outcome}
                  </p>
                </div>

                <!-- Progress Tracker Quick Card -->
                <div class="rounded-2xl border border-obs-border bg-gradient-to-br from-obs-surface to-obs-canvas-soft p-5 shadow-sm">
                  <div class="flex items-center gap-2 text-caption font-bold uppercase tracking-[0.14em] text-obs-gold">
                    <CheckCircle2 className="h-3.5 w-3.5" />
                    <span>Track Your Progress</span>
                  </div>
                  <p class="mt-2 text-xs leading-relaxed text-obs-text-muted">
                    Mark off chapters as you complete code examples and interview drills.
                  </p>
                  <a
                    href="/checklist"
                    class="btn btn-secondary mt-3.5 w-full justify-center text-xs"
                  >
                    Open Master Checklist
                  </a>
                </div>
              </aside>
            </div>
          </section>
        );
      })}
    </div>

    <!-- Bottom Callout Card -->
    <section class="surface-card flex flex-col items-start justify-between gap-6 rounded-hero p-6 sm:flex-row sm:items-center sm:p-8">
      <div class="max-w-2xl">
        <p class="eyebrow"><GraduationCap className="h-3.5 w-3.5" /> Continuous Mastery</p>
        <h2 class="mt-1 text-2xl font-bold tracking-tight text-obs-text-primary">
          Need a holistic self-assessment?
        </h2>
        <p class="mt-1 text-sm leading-relaxed text-obs-text-muted">
          Use the master checklist to evaluate your interview readiness across all {allDocs.length} topics, track your percentage completion, and target remaining gaps.
        </p>
      </div>
      <a href="/checklist" class="btn btn-primary shrink-0 shadow-lg shadow-obs-glow">
        <CheckCircle2 className="h-4 w-4" />
        Open Checklist Matrix
      </a>
    </section>
  </div>
</ObsidianLayout>
