---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import { buildNavigationTree, getStats, getAllDocs } from '../lib/content';
import {
  ArrowRight,
  Compass,
  FileQuestion,
  Home,
  Library,
  Network,
  Search,
  Sparkles,
  Waypoints,
} from 'lucide-react';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);
const stats = getStats(allDocs);

const suggestions = allDocs
  .filter((doc) => doc.domain !== 'root' && doc.kind !== 'checklist')
  .slice(0, 6);

const fmt = new Intl.NumberFormat('en-US');
---

<ObsidianLayout
  title="Page not found"
  description="The requested chapter or path could not be found in the Java Masterclass."
  navigation={navigation}
  noIndex
>
  <div class="not-prose mx-auto max-w-3xl py-12">
    <div class="surface-card relative overflow-hidden rounded-hero border border-obs-border">
      <!-- Error header -->
      <div class="relative border-b border-obs-border bg-obs-surface p-8 text-center sm:p-12">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-sm border border-obs-border bg-obs-canvas-soft font-mono text-2xl font-bold text-obs-text-primary">
          404
        </div>

        <div class="mt-4 inline-flex items-center gap-1.5 rounded-sm border border-obs-border bg-obs-canvas-soft px-3 py-1 text-xs font-medium text-obs-text-muted">
          <FileQuestion className="h-3 w-3" />
          <span>Note Not Found</span>
        </div>

        <h1 class="mt-3 text-2xl font-bold tracking-tight text-obs-text-primary sm:text-4xl">
          This Document Does Not Exist
        </h1>

        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-obs-text-muted">
          The path may have been restructured, moved into a different domain, or mistyped. Every one of the {fmt.format(stats.documents)} chapters in the masterclass remains reachable.
        </p>

        <!-- Search Form inside 404 -->
        <form action="/search" method="get" class="relative mx-auto mt-6 flex max-w-md" role="search">
          <label for="error-search-input" class="sr-only">Search knowledge base</label>
          <Search className="pointer-events-none absolute left-3.5 top-3 h-4 w-4 shrink-0 text-obs-text-muted" />
          <input
            id="error-search-input"
            name="q"
            type="search"
            required
            placeholder="Search topic or concept…"
            class="field min-w-0 flex-1 rounded-r-none py-2.5 pl-10 pr-3 text-xs text-obs-text-primary placeholder:text-obs-text-muted focus:outline-none sm:text-sm"
            autocomplete="off"
          />
          <button type="submit" class="btn btn-primary shrink-0 rounded-l-none px-4">
            Search
          </button>
        </form>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href="/" class="btn btn-primary">
            <Home className="h-4 w-4" /> Home
          </a>
          <a href="/library" class="btn btn-secondary">
            <Library className="h-4 w-4" /> Complete Library
          </a>
          <a href="/graph" class="btn btn-secondary">
            <Network className="h-4 w-4" /> Knowledge Graph
          </a>
        </div>
      </div>

      <!-- Popular Entry Points Section -->
      <div class="p-6 sm:p-8">
        <div class="flex items-center justify-between pb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-obs-text-muted">
            Popular Chapters to Explore
          </span>
          <span class="text-xs text-obs-text-muted">
            {stats.domains} domains available
          </span>
        </div>

        <ul class="divide-y divide-obs-border-subtle">
          {suggestions.map((doc) => (
            <li>
              <a
                href={doc.slug}
                class="group flex items-center justify-between gap-3 py-3 transition-colors hover:text-obs-accent"
              >
                <div class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-semibold text-obs-text-secondary group-hover:text-obs-accent transition-colors">
                    {doc.title}
                  </span>
                  <span class="block text-xs text-obs-text-muted">
                    {doc.domainTitle} · {doc.categoryTitle}
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="shrink-0 font-mono text-xs text-obs-text-muted">
                    {doc.readingTimeMinutes} min
                  </span>
                  <ArrowRight className="h-3.5 w-3.5 text-obs-text-muted opacity-0 transition-all group-hover:translate-x-0.5 group-hover:opacity-100" />
                </div>
              </a>
            </li>
          ))}
        </ul>

        <!-- Bottom Footer Meta Strip -->
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-obs-border-subtle pt-5 text-xs text-obs-text-muted">
          <div class="flex items-center gap-4">
            <a href="/graph" class="inline-flex items-center gap-1.5 hover:text-obs-accent">
              <Compass className="h-3.5 w-3.5" /> Knowledge Graph
            </a>
            <a href="/paths" class="inline-flex items-center gap-1.5 hover:text-obs-accent">
              <Waypoints className="h-3.5 w-3.5" /> Learning Paths
            </a>
          </div>
          <span class="inline-flex items-center gap-1">
            <Sparkles className="h-3.5 w-3.5 text-obs-gold" />
            Press <kbd class="font-bold text-obs-text-primary">⌘K</kbd> anywhere for instant search
          </span>
        </div>
      </div>
    </div>
  </div>
</ObsidianLayout>
