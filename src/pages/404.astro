---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import { buildNavigationTree, getStats, getAllDocs } from '../lib/content';
import { Compass, Home, Library, Search, Waypoints } from 'lucide-react';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);
const stats = getStats(allDocs);

const suggestions = allDocs
  .filter((doc) => doc.domain !== 'root' && doc.kind !== 'checklist')
  .slice(0, 6);
---

<ObsidianLayout
  title="Page not found"
  description="The requested chapter or path could not be found."
  navigation={navigation}
  noIndex
>
  <div class="not-prose mx-auto max-w-2xl py-10">
    <div class="surface-card overflow-hidden">
      <div class="border-b border-obs-border bg-gradient-to-b from-obs-surface to-obs-canvas-soft p-8 text-center">
        <div
          class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-obs-accent/35 bg-obs-accent/10 font-mono text-2xl font-bold text-obs-accent"
          aria-hidden="true"
        >
          404
        </div>
        <h1 class="mt-4 font-serif text-2xl font-bold text-obs-text-primary sm:text-3xl">
          This note does not exist
        </h1>
        <p class="mx-auto mt-2 max-w-md text-pretty text-sm leading-relaxed text-obs-text-muted">
          The path may have been renamed, moved, or the link may have been mistyped. Every one of the
          {stats.documents} chapters in the knowledge base is reachable from the library.
        </p>

        <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
          <a href="/" class="btn btn-primary"><Home className="h-4 w-4" /> Home</a>
          <a href="/library" class="btn btn-secondary"><Library className="h-4 w-4 text-obs-accent" /> Library</a>
          <a href="/search" class="btn btn-secondary"><Search className="h-4 w-4 text-obs-accent" /> Search</a>
        </div>
      </div>

      <div class="p-6">
        <p class="text-[0.62rem] font-bold uppercase tracking-[0.14em] text-obs-text-muted">
          Popular entry points
        </p>
        <ul class="mt-2 divide-y divide-obs-border-subtle">
          {suggestions.map((doc) => (
            <li>
              <a href={doc.slug} class="group flex items-center justify-between gap-3 py-2">
                <span class="min-w-0">
                  <span class="block truncate text-[0.82rem] font-medium text-obs-text-secondary group-hover:text-obs-accent">
                    {doc.title}
                  </span>
                  <span class="block text-[0.62rem] text-obs-text-muted">{doc.domainTitle}</span>
                </span>
                <span class="shrink-0 font-mono text-[0.6rem] text-obs-text-muted">
                  {doc.readingTimeMinutes} min
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-5 flex flex-wrap items-center gap-4 border-t border-obs-border-subtle pt-4 text-[0.68rem] text-obs-text-muted">
          <a href="/graph" class="inline-flex items-center gap-1 hover:text-obs-accent">
            <Compass className="h-3.5 w-3.5" /> Knowledge graph
          </a>
          <a href="/paths" class="inline-flex items-center gap-1 hover:text-obs-accent">
            <Waypoints className="h-3.5 w-3.5" /> Learning paths
          </a>
          <span class="ml-auto">
            Press <kbd>⌘K</kbd> anywhere to search
          </span>
        </div>
      </div>
    </div>
  </div>
</ObsidianLayout>
