---
import '@fontsource-variable/literata';
import fs from 'node:fs';
import path from 'node:path';
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import JavaCodeViewer from '../components/JavaCodeViewer.astro';
import {
  buildNavigationTree,
  getAllDocs,
  getLandingPages,
  getRelatedDocs,
} from '../lib/content';
import { buildKnowledgeGraph } from '../lib/graphBuilder';
import { renderMarkdown } from '../lib/markdownRenderer';
import type {
  BacklinkItem,
  DocMetadata,
  LandingPage,
  NavigationNode,
  OutgoingLinkItem,
} from '../lib/types';
import { DOMAIN_COLORS } from '../lib/constants';
import {
  ArrowLeft,
  ArrowRight,
  BookOpen,
  Clock,
  FileCode,
  FileText,
  Layers,
  Sparkles,
} from 'lucide-react';

interface NavDocItem {
  title: string;
  slug: string;
  domainTitle?: string;
  readingTime?: number;
}

interface LandingProps {
  kind: 'landing';
  landing: LandingPage;
  navigation: NavigationNode[];
}

interface DocProps {
  kind: 'doc';
  doc: DocMetadata;
  navigation: NavigationNode[];
  backlinks: BacklinkItem[];
  outgoing: OutgoingLinkItem[];
  prevDoc: NavDocItem | null;
  nextDoc: NavDocItem | null;
  related: { title: string; slug: string; domainTitle: string; summary: string }[];
  html: string;
}

type Props = LandingProps | DocProps;

export async function getStaticPaths() {
  const allDocs = getAllDocs();
  const navigation = buildNavigationTree(allDocs);
  const graph = buildKnowledgeGraph(allDocs);

  const bySlug = new Map(allDocs.map((doc) => [doc.slug, doc]));
  const ordered: DocMetadata[] = [];
  const seen = new Set<string>();
  const walk = (nodes: NavigationNode[]) => {
    for (const node of nodes) {
      if (node.slug && bySlug.has(node.slug) && !seen.has(node.slug)) {
        seen.add(node.slug);
        ordered.push(bySlug.get(node.slug)!);
      }
      if (node.children) walk(node.children);
    }
  };
  walk(navigation);
  const orderedIndex = new Map(ordered.map((doc, index) => [doc.slug, index]));

  const docPaths = await Promise.all(
    allDocs.map(async (doc) => {
      const fullPath = path.join(process.cwd(), doc.filePath);
      const content = fs.existsSync(fullPath) ? fs.readFileSync(fullPath, 'utf-8') : '';
      const html = await renderMarkdown(content, doc.filePath);
      const index = orderedIndex.get(doc.slug);
      const prevDoc =
        index !== undefined && index > 0
          ? {
              title: ordered[index - 1].title,
              slug: ordered[index - 1].slug,
              domainTitle: ordered[index - 1].domainTitle,
              readingTime: ordered[index - 1].readingTimeMinutes,
            }
          : null;
      const nextDoc =
        index !== undefined && index < ordered.length - 1
          ? {
              title: ordered[index + 1].title,
              slug: ordered[index + 1].slug,
              domainTitle: ordered[index + 1].domainTitle,
              readingTime: ordered[index + 1].readingTimeMinutes,
            }
          : null;
      const related = getRelatedDocs(doc, allDocs, 4).map((item) => ({
        title: item.title,
        slug: item.slug,
        domainTitle: item.domainTitle,
        summary: item.summary,
      }));

      return {
        params: { slug: doc.slug.replace(/^\//, '') },
        props: {
          kind: 'doc' as const,
          doc,
          navigation,
          backlinks: graph.backlinks[doc.slug] || [],
          outgoing: graph.outgoing[doc.slug] || [],
          prevDoc,
          nextDoc,
          related,
          html,
        },
      };
    })
  );

  const existing = new Set(allDocs.map((doc) => doc.slug));
  const landingPaths = getLandingPages(allDocs)
    .filter((landing) => !existing.has(landing.slug))
    .map((landing) => ({
      params: { slug: landing.slug.replace(/^\//, '') },
      props: {
        kind: 'landing' as const,
        landing,
        navigation,
      },
    }));

  return [...docPaths, ...landingPaths];
}

const props = Astro.props as Props;
const isDoc = props.kind === 'doc';
const docProps = isDoc ? (props as DocProps) : null;
const landingProps = !isDoc ? (props as LandingProps) : null;

const fmt = new Intl.NumberFormat('en-US');
---

{docProps && (
  <ObsidianLayout
    title={docProps.doc.title}
    description={docProps.doc.summary || `Read ${docProps.doc.title} in the Java Masterclass knowledge base.`}
    doc={docProps.doc}
    headings={docProps.doc.headings}
    backlinks={docProps.backlinks}
    outgoing={docProps.outgoing}
    navigation={docProps.navigation}
    related={docProps.related}
  >
    <div class="not-prose mb-6 flex flex-wrap items-center justify-between gap-3 rounded-sm border border-obs-border/70 bg-obs-surface/40 px-4 py-2.5 text-xs text-obs-text-muted">
      <div class="flex items-center gap-2.5">
        <span class="flex h-6 w-6 items-center justify-center rounded-sm border border-obs-border bg-obs-canvas-soft font-mono text-caption font-bold text-obs-text-secondary">
          JM
        </span>
        <span class="font-medium text-obs-text-secondary">Java Masterclass Staff</span>
        <span class="text-obs-border">•</span>
        <span class="text-caption text-obs-text-muted">Technical Curriculum</span>
      </div>

      <div class="flex flex-wrap items-center gap-3 text-caption">
        <span class="inline-flex items-center gap-1 text-obs-text-secondary">
          <Clock className="h-3 w-3" />
          {docProps.doc.readingTimeMinutes} min read
        </span>
        <span class="text-obs-border">•</span>
        <span class="font-mono text-obs-text-secondary">
          {fmt.format(docProps.doc.wordCount)} words
        </span>
        {docProps.doc.lastUpdated && (
          <>
            <span class="text-obs-border">•</span>
            <span>Updated {docProps.doc.lastUpdated}</span>
          </>
        )}
      </div>
    </div>

    {docProps.doc.isEmpty ? (
      <div class="not-prose my-12 overflow-hidden rounded-sm border border-obs-border bg-obs-surface p-8 text-center sm:p-12">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-sm border border-obs-border bg-obs-canvas-soft text-obs-text-muted">
          <BookOpen className="h-7 w-7" />
        </div>
        <div class="mt-4 inline-flex items-center gap-1.5 rounded-sm border border-obs-border bg-obs-canvas-soft px-3 py-1 text-xs font-medium text-obs-text-muted">
          <Sparkles className="h-3 w-3" />
          Curriculum Topic Scaffold
        </div>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-obs-text-primary sm:text-3xl">
          {docProps.doc.title}
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-obs-text-muted">
          This algorithmic concept or pattern is scaffolded into the curriculum outline. The detailed problem patterns, dry-runs, and runnable Java implementations live in the comprehensive DSA track.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href="/java-dsa" class="btn btn-primary">
            Browse DSA Directory <ArrowRight className="h-3.5 w-3.5" />
          </a>
          <a href="/library" class="btn btn-secondary">
            Search in Library
          </a>
        </div>
      </div>
    ) : (
      <div class="doc-markdown-content relative max-w-none">
        <Fragment set:html={docProps.html} />
      </div>
    )}

    {docProps.doc.relatedJavaFiles && docProps.doc.relatedJavaFiles.length > 0 && (
      <div class="not-prose mt-12">
        <div class="mb-3 flex items-center gap-2">
          <FileCode className="h-4 w-4 text-obs-accent" />
          <h3 class="text-sm font-bold uppercase tracking-wider text-obs-text-primary">
            Accompanying Source Implementations ({docProps.doc.relatedJavaFiles.length})
          </h3>
        </div>
        <JavaCodeViewer filePaths={docProps.doc.relatedJavaFiles} />
      </div>
    )}

    {(docProps.prevDoc || docProps.nextDoc) && (
      <nav
        class="no-print mt-14 grid grid-cols-1 gap-4 border-t border-obs-border pt-8 sm:grid-cols-2"
        aria-label="Previous and next chapter"
      >
        {docProps.prevDoc ? (
          <a
            href={docProps.prevDoc.slug}
            class="surface-card surface-card-hover group flex flex-col justify-between p-5 transition-all duration-200"
          >
            <div>
              <span class="inline-flex items-center gap-1.5 text-caption font-bold uppercase tracking-[0.14em] text-obs-text-muted group-hover:text-obs-accent transition-colors">
                <ArrowLeft className="h-3.5 w-3.5 transition-transform group-hover:-translate-x-1" />
                <span>Previous Chapter</span>
              </span>
              <h3 class="mt-2 text-base font-bold text-obs-text-primary group-hover:text-obs-accent transition-colors">
                {docProps.prevDoc.title}
              </h3>
            </div>
            {docProps.prevDoc.domainTitle && (
              <div class="mt-4 flex items-center justify-between border-t border-obs-border-subtle pt-2.5 text-caption text-obs-text-muted">
                <span>{docProps.prevDoc.domainTitle}</span>
                {docProps.prevDoc.readingTime && (
                  <span>{docProps.prevDoc.readingTime} min read</span>
                )}
              </div>
            )}
          </a>
        ) : (
          <div class="hidden sm:block" />
        )}

        {docProps.nextDoc && (
          <a
            href={docProps.nextDoc.slug}
            class="surface-card surface-card-hover group flex flex-col justify-between p-5 text-right transition-all duration-200 sm:col-start-2"
          >
            <div>
              <span class="inline-flex items-center justify-end gap-1.5 text-caption font-bold uppercase tracking-[0.14em] text-obs-text-muted group-hover:text-obs-accent transition-colors">
                <span>Next Chapter</span>
                <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
              </span>
              <h3 class="mt-2 text-base font-bold text-obs-text-primary group-hover:text-obs-accent transition-colors">
                {docProps.nextDoc.title}
              </h3>
            </div>
            {docProps.nextDoc.domainTitle && (
              <div class="mt-4 flex items-center justify-between border-t border-obs-border-subtle pt-2.5 text-caption text-obs-text-muted">
                {docProps.nextDoc.readingTime && (
                  <span>{docProps.nextDoc.readingTime} min read</span>
                )}
                <span>{docProps.nextDoc.domainTitle}</span>
              </div>
            )}
          </a>
        )}
      </nav>
    )}
  </ObsidianLayout>
)}

{landingProps && (
  <ObsidianLayout
    title={landingProps.landing.title}
    description={landingProps.landing.summary}
    navigation={landingProps.navigation}
    eyebrow={`${landingProps.landing.domainTitle} · ${landingProps.landing.docs.length} chapters`}
    wide
  >
    <div class="not-prose space-y-10">
      <header class="space-y-4 border-b border-obs-border pb-8">
        <div class="inline-flex items-center gap-2 rounded-sm border border-obs-border bg-obs-canvas-soft px-3 py-1 text-xs font-medium text-obs-text-muted">
          <Layers className="h-3.5 w-3.5" />
          <span>{landingProps.landing.domainTitle} Module</span>
        </div>

        <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
          <div>
            <h1 class="page-heading">
              {landingProps.landing.title}
            </h1>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-obs-text-muted sm:text-base">
              {landingProps.landing.summary || `This module groups ${landingProps.landing.docs.length} detailed chapters with theory, runnable code, and interview notes.`}
            </p>
          </div>

          <div class="flex items-center gap-3">
            <div class="rounded-xl border border-obs-border bg-obs-surface/80 px-4 py-2.5 text-center shadow-sm">
              <div class="font-mono text-lg font-bold text-obs-text-primary">{landingProps.landing.docs.length}</div>
              <div class="text-micro font-medium uppercase tracking-wider text-obs-text-muted">Topics</div>
            </div>
            <div class="rounded-xl border border-obs-border bg-obs-surface/80 px-4 py-2.5 text-center shadow-sm">
              <div class="font-mono text-lg font-bold text-obs-accent">
                {Math.round(landingProps.landing.docs.reduce((acc, d) => acc + d.readingTimeMinutes, 0))}m
              </div>
              <div class="text-micro font-medium uppercase tracking-wider text-obs-text-muted">Total Time</div>
            </div>
          </div>
        </div>
      </header>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {landingProps.landing.docs.map((doc, idx) => {
          const color = DOMAIN_COLORS[doc.domain];
          return (
            <a
              href={doc.slug}
              class="surface-card surface-card-hover group flex flex-col justify-between overflow-hidden p-5 transition-all duration-200"
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span
                    class="rounded-md border px-2 py-0.5 text-micro font-bold uppercase tracking-wider"
                    style={{
                      backgroundColor: color?.bg,
                      color: color?.text,
                      borderColor: color?.border,
                    }}
                  >
                    {doc.categoryTitle}
                  </span>
                  <div class="flex items-center gap-1.5">
                    {doc.level && <span class="badge text-micro">{doc.level}</span>}
                    <span class="font-mono text-caption text-obs-text-muted">#{idx + 1}</span>
                  </div>
                </div>

                <h2 class="mt-3 text-lg font-bold leading-snug text-obs-text-primary group-hover:text-obs-accent transition-colors">
                  {doc.title}
                </h2>

                {doc.summary && (
                  <p class="mt-2 line-clamp-3 text-xs leading-relaxed text-obs-text-muted">
                    {doc.summary}
                  </p>
                )}
              </div>

              <div class="mt-5 flex items-center justify-between border-t border-obs-border-subtle pt-3 text-xs text-obs-text-muted">
                <span class="inline-flex items-center gap-1 font-mono text-caption">
                  <FileText className="h-3 w-3 text-obs-accent" />
                  {fmt.format(doc.wordCount)} words
                </span>
                <span class="inline-flex items-center gap-1 text-caption">
                  <Clock className="h-3 w-3 text-obs-accent" />
                  {doc.readingTimeMinutes} min
                </span>
                <span class="inline-flex items-center gap-1 font-semibold text-obs-accent group-hover:translate-x-0.5 transition-transform">
                  Read <ArrowRight className="h-3 w-3" />
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </ObsidianLayout>
)}
