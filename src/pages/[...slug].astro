---
import fs from 'node:fs';
import path from 'node:path';
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import JavaCodeViewer from '../components/JavaCodeViewer.astro';
import { getAllDocs, buildNavigationTree } from '../lib/content';
import { buildKnowledgeGraph } from '../lib/graphBuilder';
import { renderMarkdown } from '../lib/markdownRenderer';
import type { DocMetadata, BacklinkItem, OutgoingLinkItem, NavigationNode } from '../lib/types';

export async function getStaticPaths() {
  const allDocs = getAllDocs();
  const navigation = buildNavigationTree(allDocs);
  const graph = buildKnowledgeGraph(allDocs);

  return allDocs.map((doc, idx) => {
    // Strip leading slash for Astro dynamic slug param
    const cleanSlug = doc.slug.replace(/^\//, '');
    const prevDoc = idx > 0 ? { title: allDocs[idx - 1].title, slug: allDocs[idx - 1].slug } : null;
    const nextDoc = idx < allDocs.length - 1 ? { title: allDocs[idx + 1].title, slug: allDocs[idx + 1].slug } : null;

    return {
      params: { slug: cleanSlug },
      props: {
        doc,
        navigation,
        backlinks: graph.backlinks[doc.slug] || [],
        outgoing: graph.outgoing[doc.slug] || [],
        prevDoc,
        nextDoc,
      },
    };
  });
}

interface Props {
  doc: DocMetadata;
  navigation: NavigationNode[];
  backlinks: BacklinkItem[];
  outgoing: OutgoingLinkItem[];
  prevDoc: { title: string; slug: string } | null;
  nextDoc: { title: string; slug: string } | null;
}

const { doc, navigation, backlinks, outgoing, prevDoc, nextDoc } = Astro.props;

// Read content from repository source file
const fullPath = path.join(process.cwd(), doc.filePath);
let content = '';
if (fs.existsSync(fullPath)) {
  content = fs.readFileSync(fullPath, 'utf-8');
}

// Render markdown to HTML
const html = await renderMarkdown(content, doc.filePath);
---

<ObsidianLayout
  title={doc.title}
  doc={doc}
  headings={doc.headings}
  backlinks={backlinks}
  outgoing={outgoing}
  navigation={navigation}
  prevDoc={prevDoc}
  nextDoc={nextDoc}
>
  {doc.isEmpty ? (
    <div class="my-10 p-6 rounded-xl border border-obs-border bg-obs-sidebar text-center space-y-3">
      <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-obs-accent/20 text-obs-accent font-bold">
        ℹ
      </div>
      <h2 class="text-lg font-bold text-obs-text-primary">Reference Scaffold Note</h2>
      <p class="text-sm text-obs-text-muted max-w-lg mx-auto">
        This topic note is scaffolded in the curriculum. Detailed problem patterns and implementations for this topic are available in the DSA Algorithms track.
      </p>
      <a href="/java-dsa" class="inline-block mt-2 rounded-md bg-obs-accent px-4 py-2 text-xs font-semibold text-white hover:bg-obs-accent-hover transition-colors">
        Browse DSA Problem Directory →
      </a>
    </div>
  ) : (
    <Fragment set:html={html} />
  )}

  {doc.relatedJavaFiles && doc.relatedJavaFiles.length > 0 && (
    <JavaCodeViewer filePaths={doc.relatedJavaFiles} />
  )}
</ObsidianLayout>

<!-- Mermaid diagram client script -->
<script>
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';

  function initMermaid() {
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    mermaid.initialize({
      startOnLoad: true,
      theme: isDark ? 'dark' : 'neutral',
      fontFamily: 'Inter, sans-serif',
      securityLevel: 'loose',
    });
    mermaid.run({
      querySelector: '.mermaid',
    });
  }

  if (document.querySelector('.mermaid')) {
    initMermaid();
  }
</script>
