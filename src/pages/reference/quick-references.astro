---
import ObsidianLayout from '../../layouts/ObsidianLayout.astro';
import { buildNavigationTree, getAllDocs, getStats } from '../../lib/content';
import { DOMAIN_COLORS } from '../../lib/constants';
import { ArrowRight, BookMarked, BookOpen, FileText, ShieldCheck, Sparkles } from 'lucide-react';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);
const stats = getStats(allDocs);

const quickReferences = allDocs
  .filter((doc) => doc.kind === 'reference')
  .sort((a, b) => a.domainTitle.localeCompare(b.domainTitle) || a.title.localeCompare(b.title));

const standards = allDocs
  .filter((doc) => doc.kind === 'standard')
  .sort((a, b) => a.domainTitle.localeCompare(b.domainTitle));

const checklists = allDocs.filter((doc) => doc.kind === 'checklist');

const fmt = new Intl.NumberFormat('en-US');
---

<ObsidianLayout
  title="Quick references"
  description="Condensed cheat sheets, coding standards, and checklists across the Java Masterclass."
  navigation={navigation}
  wide
>
  <div class="not-prose space-y-9">
    <header class="space-y-3 border-b border-obs-border pb-6">
      <p class="eyebrow"><BookMarked className="h-3.5 w-3.5" /> Reference desk</p>
      <h1 class="font-serif text-3xl font-bold tracking-tight text-obs-text-primary sm:text-4xl">
        Quick references
      </h1>
      <p class="max-w-2xl text-sm leading-relaxed text-obs-text-muted">
        The dense, revisitable layer: domain cheat sheets, engineering standards, and master
        checklists. Short enough to scan before an interview, complete enough to trust.
      </p>
      <div class="flex flex-wrap gap-2 pt-1">
        <span class="badge"><Sparkles className="h-3 w-3" /> {fmt.format(quickReferences.length)} cheat sheets</span>
        <span class="badge"><ShieldCheck className="h-3 w-3" /> {standards.length} standards</span>
        <span class="badge"><FileText className="h-3 w-3" /> {checklists.length} checklists</span>
      </div>
    </header>

    {quickReferences.length > 0 && (
      <section aria-labelledby="cheatsheets-heading" class="space-y-3">
        <div class="flex items-end justify-between gap-2">
          <div>
            <h2 id="cheatsheets-heading" class="font-serif text-xl font-bold text-obs-text-primary">
              Cheat sheets
            </h2>
            <p class="text-[0.72rem] text-obs-text-muted">Per-domain condensed revision notes.</p>
          </div>
          <a href="/library" class="text-[0.7rem] font-semibold text-obs-accent hover:underline">Library →</a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {quickReferences.map((doc) => {
            const color = DOMAIN_COLORS[doc.domain];
            return (
              <a href={doc.slug} class="surface-card surface-card-hover group flex flex-col p-4">
                <div class="flex items-center justify-between gap-2">
                  <span
                    class="rounded-full border px-2 py-0.5 text-[0.58rem] font-bold uppercase tracking-wider"
                    style={{ backgroundColor: color?.bg, color: color?.text, borderColor: color?.border }}
                  >
                    {doc.domainTitle}
                  </span>
                  <span class="font-mono text-[0.6rem] text-obs-text-muted">{doc.readingTimeMinutes} min</span>
                </div>
                <h3 class="mt-2 font-serif text-[1.02rem] font-semibold leading-snug text-obs-text-primary group-hover:text-obs-accent">
                  {doc.title}
                </h3>
                {doc.summary && (
                  <p class="mt-1.5 line-clamp-3 text-[0.74rem] leading-relaxed text-obs-text-muted">{doc.summary}</p>
                )}
                <div class="mt-auto flex items-center justify-between border-t border-obs-border-subtle pt-2.5 text-[0.62rem] text-obs-text-muted">
                  <span>{fmt.format(doc.wordCount)} words</span>
                  <ArrowRight className="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {standards.length > 0 && (
      <section aria-labelledby="standards-heading" class="space-y-3">
        <div class="flex items-end justify-between gap-2">
          <div>
            <h2 id="standards-heading" class="font-serif text-xl font-bold text-obs-text-primary">
              Engineering standards
            </h2>
            <p class="text-[0.72rem] text-obs-text-muted">
              Conventions every chapter in the domain follows.
            </p>
          </div>
          <a href="/standards" class="text-[0.7rem] font-semibold text-obs-accent hover:underline">Standards hub →</a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {standards.map((doc) => (
            <a
              href={`/standards/${doc.domain}`}
              class="surface-card surface-card-hover group flex items-center gap-3 p-4"
            >
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-obs-gold/30 bg-obs-gold/10 text-obs-gold">
                <ShieldCheck className="h-4 w-4" />
              </span>
              <span class="min-w-0">
                <span class="block truncate text-[0.82rem] font-semibold text-obs-text-primary group-hover:text-obs-accent">
                  {doc.domainTitle}
                </span>
                <span class="block truncate text-[0.62rem] text-obs-text-muted">{doc.title}</span>
              </span>
              <ArrowRight className="ml-auto h-3 w-3 shrink-0 text-obs-text-muted opacity-40 group-hover:opacity-100" />
            </a>
          ))}
        </div>
      </section>
    )}

    {checklists.length > 0 && (
      <section aria-labelledby="checklists-heading" class="space-y-3">
        <div class="flex items-end justify-between gap-2">
          <div>
            <h2 id="checklists-heading" class="font-serif text-xl font-bold text-obs-text-primary">
              Checklists
            </h2>
            <p class="text-[0.72rem] text-obs-text-muted">Coverage maps and progress trackers.</p>
          </div>
          <a href="/checklist" class="text-[0.7rem] font-semibold text-obs-accent hover:underline">
            Interactive tracker →
          </a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {checklists.map((doc) => (
            <a href={doc.slug} class="surface-card surface-card-hover group flex items-start gap-3 p-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-obs-emerald/30 bg-obs-emerald/10 text-obs-emerald">
                <BookOpen className="h-4 w-4" />
              </span>
              <span class="min-w-0">
                <span class="block text-[0.84rem] font-semibold text-obs-text-primary group-hover:text-obs-accent">
                  {doc.title}
                </span>
                <span class="mt-0.5 block text-[0.68rem] leading-relaxed text-obs-text-muted">
                  {doc.summary || `${doc.domainTitle} · ${fmt.format(doc.wordCount)} words`}
                </span>
              </span>
            </a>
          ))}
          <a href="/checklist" class="surface-card surface-card-hover group flex items-start gap-3 p-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-obs-accent/30 bg-obs-accent/10 text-obs-accent">
              <Sparkles className="h-4 w-4" />
            </span>
            <span class="min-w-0">
              <span class="block text-[0.84rem] font-semibold text-obs-text-primary group-hover:text-obs-accent">
                Interactive study checklist
              </span>
              <span class="mt-0.5 block text-[0.68rem] leading-relaxed text-obs-text-muted">
                Check off topics and store progress in your browser.
              </span>
            </span>
          </a>
        </div>
      </section>
    )}

    <section class="surface-card flex flex-col items-start justify-between gap-4 p-6 sm:flex-row sm:items-center">
      <div>
        <p class="eyebrow"><BookMarked className="h-3.5 w-3.5" /> Keep it current</p>
        <h2 class="mt-1 font-serif text-xl font-bold text-obs-text-primary">
          {fmt.format(stats.documents)} documents, generated from the repository
        </h2>
        <p class="mt-1 max-w-xl text-xs leading-relaxed text-obs-text-muted">
          Every reference page is plain Markdown in the repository. Read the authoring guide to add a
          new cheat sheet, standard, or chapter in the same structure.
        </p>
      </div>
      <a href="/docs/authoring" class="btn btn-primary">Authoring guide <ArrowRight className="h-3.5 w-3.5" /></a>
    </section>
  </div>
</ObsidianLayout>
