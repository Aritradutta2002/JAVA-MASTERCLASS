---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import DomainIcon from '../components/DomainIcon.astro';
import {
  buildNavigationTree,
  getAllDocs,
  getStats,
  getLandingPages,
} from '../lib/content';
import { buildKnowledgeGraph } from '../lib/graphBuilder';
import { DOMAIN_COLORS, DOMAIN_DESCRIPTIONS, DOMAIN_ORDER, DOMAIN_TITLES, SITE } from '../lib/constants';
import {
  ArrowRight,
  BookOpen,
  CheckSquare,
  Compass,
  FileText,
  GitBranch,
  Library,
  Network,
  Search,
  Sparkles,
  Waypoints,
} from 'lucide-react';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);
const stats = getStats(allDocs);
const graph = buildKnowledgeGraph(allDocs);
const landings = getLandingPages(allDocs);


const domainCards = DOMAIN_ORDER.filter(
  (domain) => domain !== 'root' && allDocs.some((doc) => doc.domain === domain)
).map((domain) => {
  const docs = allDocs.filter((doc) => doc.domain === domain);
  const categories = new Map<string, number>();
  for (const doc of docs) categories.set(doc.categoryTitle, (categories.get(doc.categoryTitle) || 0) + 1);
  const topCategories = [...categories.entries()]
    .sort((a, b) => b[1] - a[1])
    .slice(0, 3)
    .map(([title]) => title);
  return {
    id: domain,
    title: DOMAIN_TITLES[domain] || domain,
    description: DOMAIN_DESCRIPTIONS[domain] || '',
    href: domain === 'java-dsa' ? '/java-dsa' : `/${domain}`,
    count: docs.length,
    words: docs.reduce((sum, doc) => sum + doc.wordCount, 0),
    color: DOMAIN_COLORS[domain],
    topCategories,
    sample: docs.slice(0, 3).map((doc) => doc.title),
  };
});

const featured = [
  ...allDocs.filter((doc) => doc.domain === 'root'),
  ...DOMAIN_ORDER.filter((domain) => domain !== 'root')
    .map((domain) => allDocs.find((doc) => doc.domain === domain && doc.kind === 'domain'))
    .filter((doc): doc is NonNullable<typeof doc> => Boolean(doc)),
].slice(0, 8);

const mostConnected = [...graph.nodes]
  .sort((a, b) => b.degree - a.degree || a.title.localeCompare(b.title))
  .slice(0, 6)
  .map((node) => allDocs.find((doc) => doc.slug === node.slug))
  .filter((doc): doc is NonNullable<typeof doc> => Boolean(doc));

const paths = [
  {
    title: 'Java backend foundations',
    description: 'Language, JVM, collections, generics, streams, and concurrency. Build the base every interview assumes.',
    href: '/paths#java-backend-foundations',
    domain: 'Core Java',
    color: 'amber',
    weeks: '4 weeks',
    docs: allDocs.filter((doc) => doc.domain === 'core-java').length,
  },
  {
    title: 'Spring Boot in production',
    description: 'Auto-configuration, MVC, JPA, security, messaging, caching, and deployment for real services.',
    href: '/paths#spring-boot-in-production',
    domain: 'Spring Boot',
    color: 'emerald',
    weeks: '6 weeks',
    docs: allDocs.filter((doc) => doc.domain === 'spring-boot').length,
  },
  {
    title: 'Distributed systems and HLD',
    description: 'Fundamentals, CAP, storage, caching, messaging, observability, and end-to-end case studies.',
    href: '/paths#distributed-systems-and-hld',
    domain: 'System Design',
    color: 'sky',
    weeks: '5 weeks',
    docs: allDocs.filter((doc) => doc.domain === 'system-design').length,
  },
  {
    title: 'Interview algorithms',
    description: 'Patterns, data structures, graph masterclass, dynamic programming, and runnable Java solutions.',
    href: '/paths#interview-algorithms',
    domain: 'DSA',
    color: 'rose',
    weeks: '8 weeks',
    docs: allDocs.filter((doc) => doc.domain === 'java-dsa').length,
  },
];

const fmt = new Intl.NumberFormat('en-US');
---

<ObsidianLayout
  title="Home"
  description={SITE.description}
  navigation={navigation}
  wide
>
  <div class="not-prose space-y-14">
    <!-- Hero -->
    <section class="relative overflow-hidden rounded-3xl border border-obs-border bg-gradient-to-b from-obs-surface via-obs-surface/70 to-obs-canvas-soft shadow-obs-lg">
      <div class="pointer-events-none absolute -right-24 -top-28 h-80 w-80 rounded-full bg-obs-accent/15 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-20 h-72 w-72 rounded-full bg-obs-gold/10 blur-3xl"></div>
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(167,139,250,0.08),transparent_55%)]"></div>

      <div class="relative z-10 grid gap-10 p-6 sm:p-10 lg:grid-cols-[1.35fr_0.65fr] lg:p-12">
        <div class="space-y-6">
          <p class="inline-flex items-center gap-2 rounded-full border border-obs-accent/30 bg-obs-accent/10 px-3 py-1 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-obs-accent">
            <Sparkles className="h-3.5 w-3.5" />
            A connected Java knowledge base
          </p>

          <h1 class="max-w-3xl text-balance font-serif text-4xl font-bold leading-[1.08] tracking-tight text-obs-text-primary sm:text-5xl lg:text-[3.4rem]">
            Read deeply.
            <span class="gradient-text"> Connect everything.</span>
          </h1>

          <p class="max-w-2xl text-pretty text-[0.98rem] leading-relaxed text-obs-text-secondary sm:text-[1.05rem]">
            {SITE.description} Every chapter is written as a complete lesson — theory, production
            examples, tables, diagrams, and interview framing — and linked into one navigable graph.
          </p>

          <form action="/search" method="get" class="max-w-xl" role="search">
            <label for="home-search" class="sr-only">Search the knowledge base</label>
            <div class="flex items-center gap-2 rounded-xl border border-obs-border bg-obs-canvas/80 p-1.5 shadow-obs focus-within:border-obs-accent/50">
              <Search className="ml-2 h-4 w-4 shrink-0 text-obs-accent" />
              <input
                id="home-search"
                name="q"
                type="search"
                placeholder="Search JVM memory, Kafka, CAP, dynamic programming…"
                class="min-w-0 flex-1 bg-transparent py-1.5 text-sm text-obs-text-primary placeholder:text-obs-text-muted focus:outline-none"
              />
              <button type="submit" class="btn btn-primary">Search</button>
            </div>
          </form>

          <div class="flex flex-wrap items-center gap-2.5">
            <a href="/overview" class="btn btn-primary">
              <BookOpen className="h-4 w-4" /> Start here
            </a>
            <a href="/paths" class="btn btn-secondary">
              <Waypoints className="h-4 w-4 text-obs-accent" /> Learning paths
            </a>
            <a href="/graph" class="btn btn-secondary">
              <Network className="h-4 w-4 text-obs-accent" /> Explore the graph
            </a>
          </div>
        </div>

        <div class="relative hidden lg:block">
          <div class="absolute inset-0 rounded-2xl border border-obs-border bg-obs-canvas/45 p-5 shadow-obs">
            <div class="flex items-center justify-between border-b border-obs-border-subtle pb-3">
              <span class="text-[0.62rem] font-bold uppercase tracking-[0.14em] text-obs-text-muted">
                Knowledge base
              </span>
              <span class="flex items-center gap-1 text-[0.62rem] font-semibold text-obs-emerald">
                <span class="h-1.5 w-1.5 rounded-full bg-obs-emerald"></span> Live index
              </span>
            </div>
            <dl class="mt-4 grid grid-cols-2 gap-4">
              <div>
                <dt class="text-[0.62rem] font-medium uppercase tracking-wider text-obs-text-muted">Chapters</dt>
                <dd class="mt-0.5 font-mono text-2xl font-bold text-obs-text-primary">{fmt.format(stats.documents)}</dd>
              </div>
              <div>
                <dt class="text-[0.62rem] font-medium uppercase tracking-wider text-obs-text-muted">Words</dt>
                <dd class="mt-0.5 font-mono text-2xl font-bold text-obs-text-primary">{(stats.words / 1_000_000).toFixed(2)}M</dd>
              </div>
              <div>
                <dt class="text-[0.62rem] font-medium uppercase tracking-wider text-obs-text-muted">Code blocks</dt>
                <dd class="mt-0.5 font-mono text-2xl font-bold text-obs-text-primary">{fmt.format(stats.codeBlocks)}</dd>
              </div>
              <div>
                <dt class="text-[0.62rem] font-medium uppercase tracking-wider text-obs-text-muted">Java files</dt>
                <dd class="mt-0.5 font-mono text-2xl font-bold text-obs-text-primary">{fmt.format(stats.javaFiles)}</dd>
              </div>
            </dl>
            <div class="mt-5 border-t border-obs-border-subtle pt-3">
              <p class="text-[0.62rem] font-medium uppercase tracking-wider text-obs-text-muted">Modules with generated overviews</p>
              <p class="mt-1 font-mono text-lg font-semibold text-obs-gold">{landings.length}</p>
            </div>
            <a href="/library" class="mt-4 flex items-center justify-between rounded-lg border border-obs-border bg-obs-surface px-3 py-2 text-[0.72rem] font-semibold text-obs-text-secondary hover:border-obs-accent/40 hover:text-obs-accent">
              Open complete library <ArrowRight className="h-3.5 w-3.5" />
            </a>
          </div>
        </div>
      </div>

      <div class="relative z-10 grid grid-cols-2 border-t border-obs-border-subtle bg-obs-canvas/40 sm:grid-cols-4">
        {[
          { label: 'Domains', value: fmt.format(stats.domains) },
          { label: 'Reading time', value: `${fmt.format(Math.round(stats.readingMinutes / 60))} h` },
          { label: 'Diagrams', value: fmt.format(stats.mermaidDiagrams) },
          { label: 'Connections', value: fmt.format(graph.edges.length) },
        ].map((item) => (
          <div class="border-b border-obs-border-subtle px-5 py-3 text-center sm:border-b-0 sm:border-r sm:last:border-r-0">
            <div class="font-mono text-sm font-bold text-obs-text-primary">{item.value}</div>
            <div class="text-[0.6rem] font-medium uppercase tracking-[0.14em] text-obs-text-muted">{item.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Learning paths -->
    <section aria-labelledby="paths-heading" class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <p class="eyebrow"><Waypoints className="h-3.5 w-3.5" /> Structured study</p>
          <h2 id="paths-heading" class="mt-1 font-serif text-2xl font-bold text-obs-text-primary">Pick a path, not a pile of tabs</h2>
        </div>
        <a href="/paths" class="text-xs font-semibold text-obs-accent hover:underline">All learning paths →</a>
      </div>

      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
        {paths.map((path) => (
          <a href={path.href} class="surface-card surface-card-hover group flex flex-col p-4">
            <div class="flex items-center justify-between">
              <span class="text-[0.6rem] font-bold uppercase tracking-[0.12em] text-obs-accent">{path.domain}</span>
              <span class="badge">{path.weeks}</span>
            </div>
            <h3 class="mt-2 font-serif text-[1.05rem] font-semibold leading-snug text-obs-text-primary group-hover:text-obs-accent">
              {path.title}
            </h3>
            <p class="mt-1.5 line-clamp-3 text-[0.76rem] leading-relaxed text-obs-text-muted">{path.description}</p>
            <div class="mt-auto flex items-center justify-between border-t border-obs-border-subtle pt-2.5 text-[0.64rem] text-obs-text-muted">
              <span>{path.docs} chapters</span>
              <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Domains -->
    <section aria-labelledby="domains-heading" class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <p class="eyebrow"><Library className="h-3.5 w-3.5" /> The library</p>
          <h2 id="domains-heading" class="mt-1 font-serif text-2xl font-bold text-obs-text-primary">{domainCards.length} domains, one coherent curriculum</h2>
        </div>
        <a href="/library" class="text-xs font-semibold text-obs-accent hover:underline">Browse all {fmt.format(stats.documents)} chapters →</a>
      </div>

      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {domainCards.map((domain) => (
          <a href={domain.href} class="surface-card surface-card-hover group flex flex-col overflow-hidden p-5">
            <div class="flex items-start justify-between gap-3">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl border"
                style={{ backgroundColor: domain.color?.bg, color: domain.color?.text, borderColor: domain.color?.border }}
              >
                <DomainIcon domain={domain.id} class="h-5 w-5" />
              </span>
              <div class="text-right">
                <div class="font-mono text-sm font-bold text-obs-text-primary">{domain.count}</div>
                <div class="text-[0.58rem] uppercase tracking-[0.12em] text-obs-text-muted">chapters</div>
              </div>
            </div>
            <h3 class="mt-3 font-serif text-lg font-bold text-obs-text-primary group-hover:text-obs-accent">{domain.title}</h3>
            <p class="mt-1.5 line-clamp-3 text-[0.78rem] leading-relaxed text-obs-text-muted">{domain.description}</p>
            <div class="mt-3 flex flex-wrap gap-1">
              {domain.topCategories.map((category) => (
                <span class="rounded border border-obs-border-subtle bg-obs-canvas-soft px-1.5 py-0.5 text-[0.58rem] font-medium text-obs-text-muted">{category}</span>
              ))}
            </div>
            <div class="mt-4 flex items-center justify-between border-t border-obs-border-subtle pt-2.5 text-[0.64rem] text-obs-text-muted">
              <span>{fmt.format(domain.words)} words</span>
              <span class="inline-flex items-center gap-1 font-semibold text-obs-accent">Explore <ArrowRight className="h-3 w-3 transition-transform group-hover:translate-x-0.5" /></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Start here + most connected -->
    <section class="grid gap-6 lg:grid-cols-2" aria-label="Start here and popular topics">
      <div class="surface-card p-5">
        <div class="flex items-center justify-between border-b border-obs-border-subtle pb-3">
          <div>
            <p class="eyebrow"><BookOpen className="h-3.5 w-3.5" /> Orientation</p>
            <h2 class="mt-1 font-serif text-xl font-bold text-obs-text-primary">Start here</h2>
          </div>
          <a href="/overview" class="text-[0.68rem] font-semibold text-obs-accent hover:underline">Overview →</a>
        </div>
        <ul class="mt-2 divide-y divide-obs-border-subtle">
          {featured.map((doc) => (
            <li>
              <a href={doc.slug} class="group flex items-center gap-3 py-2.5">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-obs-border bg-obs-canvas-soft text-obs-text-muted group-hover:text-obs-accent">
                  <FileText className="h-3.5 w-3.5" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[0.82rem] font-semibold text-obs-text-primary group-hover:text-obs-accent">{doc.title}</span>
                  <span class="block text-[0.62rem] text-obs-text-muted">{doc.domainTitle} · {doc.readingTimeMinutes} min</span>
                </span>
                <ArrowRight className="h-3 w-3 shrink-0 text-obs-text-muted opacity-0 transition-opacity group-hover:opacity-100" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="surface-card p-5">
        <div class="flex items-center justify-between border-b border-obs-border-subtle pb-3">
          <div>
            <p class="eyebrow"><GitBranch className="h-3.5 w-3.5" /> Highly connected</p>
            <h2 class="mt-1 font-serif text-xl font-bold text-obs-text-primary">Concepts that unlock the rest</h2>
          </div>
          <a href="/graph" class="text-[0.68rem] font-semibold text-obs-accent hover:underline">Graph →</a>
        </div>
        <ul class="mt-2 divide-y divide-obs-border-subtle">
          {mostConnected.map((doc) => (
            <li>
              <a href={doc.slug} class="group flex items-center gap-3 py-2.5">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-obs-border bg-obs-canvas-soft text-obs-text-muted group-hover:text-obs-accent">
                  <Network className="h-3.5 w-3.5" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[0.82rem] font-semibold text-obs-text-primary group-hover:text-obs-accent">{doc.title}</span>
                  <span class="block text-[0.62rem] text-obs-text-muted">{doc.domainTitle} · {doc.categoryTitle}</span>
                </span>
                <ArrowRight className="h-3 w-3 shrink-0 text-obs-text-muted opacity-0 transition-opacity group-hover:opacity-100" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Graph banner -->
    <section class="relative overflow-hidden rounded-2xl border border-obs-border bg-gradient-to-r from-obs-surface via-obs-surface/80 to-obs-canvas-soft p-6 sm:p-8">
      <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-obs-accent/10 blur-3xl"></div>
      <div class="relative flex flex-col items-start justify-between gap-5 md:flex-row md:items-center">
        <div class="max-w-2xl space-y-2">
          <p class="eyebrow"><Compass className="h-3.5 w-3.5" /> Relationship engine</p>
          <h2 class="font-serif text-2xl font-bold text-obs-text-primary">
            {fmt.format(graph.nodes.length)} notes · {fmt.format(graph.edges.length)} connections
          </h2>
          <p class="text-sm leading-relaxed text-obs-text-muted">
            Follow the links between JVM internals, concurrency, Spring security, database indexes,
            caching, and distributed systems. Filter by domain, search a concept, or open the
            accessible list view.
          </p>
        </div>
        <div class="flex flex-wrap gap-2.5">
          <a href="/graph" class="btn btn-primary"><Network className="h-4 w-4" /> Open graph</a>
          <a href="/tags" class="btn btn-secondary"><Sparkles className="h-4 w-4 text-obs-accent" /> Browse tags</a>
        </div>
      </div>
    </section>

    <!-- Closing grid -->
    <section class="grid gap-3 sm:grid-cols-3" aria-label="More ways to use the knowledge base">
      <a href="/checklist" class="surface-card surface-card-hover flex items-start gap-3 p-4">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-obs-emerald/30 bg-obs-emerald/10 text-obs-emerald">
          <CheckSquare className="h-4 w-4" />
        </span>
        <span>
          <span class="block text-sm font-semibold text-obs-text-primary">Track study progress</span>
          <span class="mt-0.5 block text-xs leading-relaxed text-obs-text-muted">A persistent checklist across every domain, stored locally.</span>
        </span>
      </a>
      <a href="/index-all" class="surface-card surface-card-hover flex items-start gap-3 p-4">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-obs-accent/30 bg-obs-accent/10 text-obs-accent">
          <Library className="h-4 w-4" />
        </span>
        <span>
          <span class="block text-sm font-semibold text-obs-text-primary">Complete A–Z index</span>
          <span class="mt-0.5 block text-xs leading-relaxed text-obs-text-muted">Every chapter, case study, and reference note in one place.</span>
        </span>
      </a>
      <a href="/docs/authoring" class="surface-card surface-card-hover flex items-start gap-3 p-4">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-obs-gold/30 bg-obs-gold/10 text-obs-gold">
          <FileText className="h-4 w-4" />
        </span>
        <span>
          <span class="block text-sm font-semibold text-obs-text-primary">Write a new chapter</span>
          <span class="mt-0.5 block text-xs leading-relaxed text-obs-text-muted">Frontmatter, callouts, wiki links, math, and diagram conventions.</span>
        </span>
      </a>
    </section>
  </div>
</ObsidianLayout>
