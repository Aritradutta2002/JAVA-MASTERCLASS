---
import SectionHeading from '../components/system/SectionHeading.astro';
import CurriculumSection from '../components/system/CurriculumSection.astro';
import LearningTracks from '../components/system/LearningTracks.astro';
import ReviewSection from '../components/system/ReviewSection.astro';
import WorkspacePreview from '../components/system/WorkspacePreview.astro';

import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import {
  buildNavigationTree,
  getAllDocs,
  getStats,
} from '../lib/content';
import { buildKnowledgeGraph } from '../lib/graphBuilder';
import { DOMAIN_COLORS, DOMAIN_DESCRIPTIONS, DOMAIN_ORDER, DOMAIN_TITLES, SITE } from '../lib/constants';
import {
  ArrowRight,
  ArrowUpRight,
  Network,
  Search,
} from 'lucide-react';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);
const stats = getStats(allDocs);
const graph = buildKnowledgeGraph(allDocs);

const domainCards = DOMAIN_ORDER.filter(
  (domain) => domain !== 'root' && allDocs.some((doc) => doc.domain === domain)
).map((domain) => {
  const docs = allDocs.filter((doc) => doc.domain === domain);
  const categories = new Map<string, number>();
  for (const doc of docs) categories.set(doc.categoryTitle, (categories.get(doc.categoryTitle) || 0) + 1);
  const topCategories = [...categories.entries()]
    .sort((a, b) => b[1] - a[1])
    .slice(0, 4)
    .map(([title]) => title);
  return {
    id: domain,
    title: DOMAIN_TITLES[domain] || domain,
    description: DOMAIN_DESCRIPTIONS[domain] || '',
    href: domain === 'java-dsa' ? '/java-dsa' : `/${domain}`,
    count: docs.length,
    words: docs.reduce((sum, doc) => sum + doc.wordCount, 0),
    color: DOMAIN_COLORS[domain],
    topCategories,
    sample: docs.slice(0, 3).map((doc) => doc.title),
  };
});

const paths = [
  {
    id: 'java-backend-foundations',
    title: 'Java backend foundations',
    description: 'Language, JVM, memory model, collections, generics, modern features, and concurrency. Build the base every interview assumes.',
    href: '/paths#java-backend-foundations',
    domain: 'Core Java',
    level: 'Beginner → Advanced',
    weeks: '4 weeks',
    hours: '~38 hrs',
    docs: allDocs.filter((doc) => doc.domain === 'core-java').length,
    highlight: 'JVM Internals & Concurrency',
  },
  {
    id: 'spring-boot-in-production',
    title: 'Spring Boot in production',
    description: 'Auto-configuration, Spring MVC, JPA/Hibernate, Security, messaging, caching, microservices, and containerised deployments.',
    href: '/paths#spring-boot-in-production',
    domain: 'Spring Boot',
    level: 'Intermediate → Advanced',
    weeks: '6 weeks',
    hours: '~52 hrs',
    docs: allDocs.filter((doc) => doc.domain === 'spring-boot').length,
    highlight: 'Cloud-Ready Microservices',
  },
  {
    id: 'distributed-systems-and-hld',
    title: 'Distributed systems & HLD',
    description: 'CAP, PACELC, storage engines, sharding, consensus, distributed caching, event messaging, and 12 end-to-end case studies.',
    href: '/paths#distributed-systems-and-hld',
    domain: 'System Design',
    level: 'Intermediate → Expert',
    weeks: '5 weeks',
    hours: '~45 hrs',
    docs: allDocs.filter((doc) => doc.domain === 'system-design').length,
    highlight: 'HLD Architecture & Case Studies',
  },
  {
    id: 'interview-algorithms',
    title: 'Interview algorithms & DSA',
    description: 'Algorithmic patterns, data structures, graph masterclass, dynamic programming, and production Java solutions.',
    href: '/paths#interview-algorithms',
    domain: 'DSA',
    level: 'Beginner → Advanced',
    weeks: '8 weeks',
    hours: '~60 hrs',
    docs: allDocs.filter((doc) => doc.domain === 'java-dsa').length,
    highlight: 'Pattern-Driven Problem Solving',
  },
];

const mostConnected = [...graph.nodes]
  .sort((a, b) => b.degree - a.degree || a.title.localeCompare(b.title))
  .slice(0, 6)
  .map((node) => {
    const doc = allDocs.find((d) => d.slug === node.slug);
    return doc ? { ...doc, degree: node.degree } : null;
  })
  .filter((doc): doc is NonNullable<typeof doc> => Boolean(doc));

const fmt = new Intl.NumberFormat('en-US');
const workspaceDomain = domainCards.find((domain) => domain.id === 'core-java') ?? domainCards[0];
const workspaceDoc = mostConnected[0];
const workspaceConnections = graph.outgoing[workspaceDoc?.slug] ?? [];
---

<ObsidianLayout title="Home" description={SITE.description} navigation={navigation} wide>
  <div class="home-page not-prose pb-10">
    <section class="border-b border-obs-border pb-8 pt-2 sm:pt-5" aria-labelledby="hero-heading">
      <div class="technical-label flex flex-wrap items-center gap-2 text-obs-text-muted"><span class="status-dot"></span><span>JAVA KNOWLEDGE SYSTEM</span><span aria-hidden="true">/</span><span>{fmt.format(stats.documents)} DOCUMENTS ONLINE</span></div>
      <h1 id="hero-heading" class="hero-title mt-6">Read deeply.<br /><span class="text-obs-text-secondary">Connect everything.</span></h1>
      <div class="home-lead-grid mt-6"><p class="m-0 max-w-2xl text-sm leading-relaxed text-obs-text-secondary sm:text-base">{SITE.description} Deep runtime theory, production architectures, code, diagrams, and interview questions, unified in one navigable knowledge system.</p><div class="hidden items-start gap-8 lg:flex" aria-label="Curriculum statistics"><div><p class="technical-label m-0 text-obs-text-muted">LINKED REFERENCES</p><p class="mt-2 text-2xl font-semibold text-obs-text-primary">{fmt.format(graph.edges.length)}</p></div><div><p class="technical-label m-0 text-obs-text-muted">CODE EXAMPLES</p><p class="mt-2 text-2xl font-semibold text-obs-text-primary">{fmt.format(stats.codeBlocks)}</p></div></div></div>
      <form action="/search" method="get" class="relative mt-8 flex" role="search"><Search className="pointer-events-none absolute left-4 top-3.5 h-4 w-4 text-obs-text-muted" /><label for="home-search" class="sr-only">Search the Java Masterclass</label><input id="home-search" type="search" name="q" placeholder="Search JVM memory, Spring Security, Kafka, DP…" class="field min-w-0 flex-1 rounded-r-none py-3 pl-11 pr-3 text-sm text-obs-text-primary placeholder:text-obs-text-muted focus:outline-none" /><button type="submit" class="btn btn-primary shrink-0 rounded-l-none px-6">Search <ArrowRight className="h-4 w-4" /></button></form>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-obs-text-muted"><a href="/overview" class="min-h-8 inline-flex items-center gap-1.5 font-medium text-obs-text-primary hover:underline underline-offset-4">Start reading <ArrowRight className="h-3.5 w-3.5" /></a><a href="#curriculum" class="min-h-8 inline-flex items-center hover:text-obs-text-primary">Explore the curriculum</a><span class="ml-auto technical-label">SEARCHABLE / LINKED / LOCAL-FIRST</span></div>
    </section>
    <WorkspacePreview domains={domainCards} mostConnected={workspaceDoc} workspaceDomain={workspaceDomain} outgoing={workspaceConnections} documentCount={stats.documents} connectionCount={workspaceDoc.degree} />
    <CurriculumSection domains={domainCards} metrics={[{ label: 'Documents', value: stats.documents },{ label: 'Diagrams', value: stats.mermaidDiagrams },{ label: 'Code examples', value: stats.codeBlocks },{ label: 'Indexed words', value: stats.words }]} />
    <LearningTracks paths={paths} />
    <section class="content-section" aria-labelledby="connections-heading"><SectionHeading number="03" label="CONNECTED KNOWLEDGE" id="connections-heading" title="Follow the engineer’s chain of reasoning." description="Documents retain their references and backlinks so you can move from a language mechanism to its architectural consequences without losing context." /><div class="mt-8 overflow-x-auto border border-obs-border bg-obs-surface" role="region" aria-label="Most connected documents" tabindex="0"><table class="connection-table w-full border-collapse text-left text-sm"><caption class="sr-only">Documents and the number of references linking them</caption><thead><tr class="technical-label text-obs-text-muted"><th scope="col">DOCUMENT</th><th scope="col">DOMAIN</th><th scope="col">LENGTH</th><th scope="col"><span class="sr-only">Number of </span>CONNECTIONS</th><th scope="col"><span class="sr-only">Open document</span></th></tr></thead><tbody>{mostConnected.map((doc)=><tr class="border-t border-obs-border-subtle"><th scope="row"><a href={doc.slug} class="font-medium text-obs-text-primary hover:underline underline-offset-4">{doc.title}</a></th><td class="text-obs-text-muted">{doc.domainTitle}</td><td class="font-mono text-xs text-obs-text-muted">{doc.readingTimeMinutes} min</td><td class="text-obs-text-primary">{doc.degree}</td><td><a href={doc.slug} aria-label={"Open " + doc.title} class="icon-btn"><ArrowUpRight className="h-4 w-4" /></a></td></tr>)}</tbody></table></div><div class="mt-6 flex flex-wrap gap-3"><a href="/graph" class="btn btn-primary">Open interactive graph <Network className="h-4 w-4" /></a><a href="/tags" class="btn btn-secondary">Browse concepts <ArrowRight className="h-3.5 w-3.5" /></a></div></section>
    <ReviewSection />
    <section class="home-final border-t border-obs-border pt-10" aria-labelledby="start-heading"><p class="technical-label m-0 text-obs-text-muted">/ NEXT STEP</p><h2 id="start-heading" class="mt-4 text-section font-semibold text-obs-text-primary">Build your Java<br />engineering depth.</h2><div class="mt-7 flex flex-wrap items-center gap-4"><a href="/overview" class="btn btn-primary">Start reading <ArrowUpRight className="h-4 w-4" /></a><button type="button" data-open-command class="btn btn-secondary">Search the system <kbd class="ml-2 font-mono text-micro">⌘ K</kbd></button></div></section>
  </div>
</ObsidianLayout>
