---
import ObsidianLayout from '../../layouts/ObsidianLayout.astro';
import { getAllDocs, buildNavigationTree } from '../../lib/content';
import { Code2, GitFork, ArrowRight, BookOpen, Layers, Terminal, Sparkles, CheckCircle } from 'lucide-react';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);

// Filter DSA topics
const graphDocs = allDocs.filter(d => d.slug.includes('resources/graph'));
const dpDocs = allDocs.filter(d => d.slug.includes('resources/dynamic-programming'));
const arrayDocs = allDocs.filter(d => d.slug.includes('resources/array'));
const foundationDocs = allDocs.filter(d => d.slug.includes('resources/foundations'));
const dsaPatternDocs = allDocs.filter(d => d.slug.includes('java-dsa/dsa/'));
---

<ObsidianLayout
  title="Data Structures & Algorithms Masterclass"
  description="Comprehensive DSA curriculum covering Graph Theory, Dynamic Programming, Algorithmic Patterns, and 621 Java Implementations."
  navigation={navigation}
>
  <div class="space-y-10 py-4 max-w-4xl mx-auto">
    <!-- Hero Banner -->
    <div class="rounded-2xl border border-obs-border bg-gradient-to-b from-obs-sidebar via-obs-surface to-obs-canvas p-8 md:p-10 shadow-lg space-y-4">
      <div class="inline-flex items-center gap-2 rounded-full border border-rose-500/30 bg-rose-500/10 px-3 py-1 text-xs font-semibold text-rose-400">
        <Code2 className="h-3.5 w-3.5" />
        <span>Algorithms & Problem Solving Track</span>
      </div>

      <h1 class="text-3xl md:text-4xl font-extrabold text-obs-text-primary !border-none !p-0">
        Data Structures & Algorithms Masterclass
      </h1>

      <p class="text-sm md:text-base text-obs-text-secondary leading-relaxed">
        A rigorous collection of theoretical guides, pattern breakdowns, and <strong class="text-obs-text-primary">621 production Java implementations</strong> covering graph theory, dynamic programming, monotonic structures, bit manipulation, and search techniques.
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-obs-border/50">
        <div>
          <div class="text-xl font-bold text-obs-text-primary font-mono">18</div>
          <div class="text-xs text-obs-text-muted">Graph Chapters</div>
        </div>
        <div>
          <div class="text-xl font-bold text-obs-text-primary font-mono">19</div>
          <div class="text-xs text-obs-text-muted">DP Categories</div>
        </div>
        <div>
          <div class="text-xl font-bold text-obs-text-primary font-mono">621</div>
          <div class="text-xs text-obs-text-muted">Java Solutions</div>
        </div>
        <div>
          <div class="text-xl font-bold text-rose-400 font-mono">100%</div>
          <div class="text-xs text-obs-text-muted">Dry-Run Traces</div>
        </div>
      </div>
    </div>

    <!-- 18-Chapter Graph Theory Masterclass -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-obs-text-primary !border-none !m-0">
            18-Chapter Graph Theory Masterclass
          </h2>
          <p class="text-xs text-obs-text-muted mt-1">
            Complete textbook on graph algorithms from BFS/DFS traversals to Tarjan SCC, Maximum Flow, and 2-SAT.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {graphDocs.map((doc) => (
          <a
            href={doc.slug}
            class="flex items-center justify-between p-3 rounded-lg border border-obs-border bg-obs-sidebar hover:border-obs-accent/50 hover:bg-obs-hover transition-colors group"
          >
            <div class="truncate pr-2">
              <div class="text-xs font-semibold text-obs-text-primary group-hover:text-obs-accent truncate">
                {doc.title}
              </div>
              <div class="text-[11px] text-obs-text-muted">
                {doc.readingTimeMinutes} min read · {doc.wordCount} words
              </div>
            </div>
            <ArrowRight className="h-3.5 w-3.5 text-obs-text-muted group-hover:text-obs-accent shrink-0" />
          </a>
        ))}
      </div>
    </div>

    <!-- Dynamic Programming & Array Patterns -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- DP Masterclass -->
      <div class="space-y-3">
        <h2 class="text-lg font-bold text-obs-text-primary !border-none !m-0">
          Dynamic Programming
        </h2>
        <p class="text-xs text-obs-text-muted">
          From recursion to memoization, tabulation, Knapsack variants, LCS, and LIS.
        </p>
        <div class="space-y-2">
          {dpDocs.map((doc) => (
            <a
              href={doc.slug}
              class="flex items-center justify-between p-2.5 rounded-lg border border-obs-border bg-obs-surface hover:border-obs-accent/50 hover:bg-obs-hover transition-colors group"
            >
              <span class="text-xs font-medium text-obs-text-primary group-hover:text-obs-accent truncate">
                {doc.title}
              </span>
              <ArrowRight className="h-3 w-3 text-obs-text-muted group-hover:text-obs-accent shrink-0" />
            </a>
          ))}
        </div>
      </div>

      <!-- Array & Complexity Foundations -->
      <div class="space-y-3">
        <h2 class="text-lg font-bold text-obs-text-primary !border-none !m-0">
          Arrays & Complexity Foundations
        </h2>
        <p class="text-xs text-obs-text-muted">
          Prefix sum, sliding window, Big-O notation, and complexity cheat sheets.
        </p>
        <div class="space-y-2">
          {[...arrayDocs, ...foundationDocs].map((doc) => (
            <a
              href={doc.slug}
              class="flex items-center justify-between p-2.5 rounded-lg border border-obs-border bg-obs-surface hover:border-obs-accent/50 hover:bg-obs-hover transition-colors group"
            >
              <span class="text-xs font-medium text-obs-text-primary group-hover:text-obs-accent truncate">
                {doc.title}
              </span>
              <ArrowRight className="h-3 w-3 text-obs-text-muted group-hover:text-obs-accent shrink-0" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Algorithmic Patterns & DSA Guides -->
    <div class="space-y-4">
      <h2 class="text-xl font-bold text-obs-text-primary !border-none !m-0">
        Algorithmic Patterns & Problem Collections (40 Tracks)
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5">
        {dsaPatternDocs.map((doc) => (
          <a
            href={doc.slug}
            class="flex items-center justify-between p-2.5 rounded-lg border border-obs-border bg-obs-sidebar hover:border-obs-accent/50 hover:bg-obs-hover transition-colors group"
          >
            <div class="truncate pr-2">
              <div class="text-xs font-medium text-obs-text-primary group-hover:text-obs-accent truncate">
                {doc.title}
              </div>
              <div class="text-[10px] text-obs-text-muted truncate">
                {doc.categoryTitle}
              </div>
            </div>
            <ArrowRight className="h-3 w-3 text-obs-text-muted group-hover:text-obs-accent shrink-0" />
          </a>
        ))}
      </div>
    </div>
  </div>
</ObsidianLayout>
