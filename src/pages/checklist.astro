---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import PageHeader from '../components/system/PageHeader.astro';
import MetricStrip from '../components/system/MetricStrip.astro';
import ChecklistTracker from '../components/ChecklistTracker';
import { buildNavigationTree, getAllDocs, getStats } from '../lib/content';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);
const stats = getStats(allDocs);
---

<ObsidianLayout
  title="Master study checklist"
  description="Self-assessment and progress tracking across the core technical domains for Java technical interviews."
  navigation={navigation}
  wide
>
  <div class="not-prose space-y-8">
    <!-- Header Banner -->
    <PageHeader eyebrow="05 / SELF-ASSESSMENT MATRIX" title="Verify interview readiness." description="Track language mechanics, concurrency, architecture, and coding drills. Your progress is stored locally in this browser, with no account requirement.">
      <MetricStrip metrics={[{ label:'Total topics', value:stats.documents },{ label:'Engineering domains', value:stats.domains },{ label:'Progress storage', value:'Offline' }]} />
    </PageHeader>


    <!-- Interactive Tracker Component -->
    <div class="min-h-[30rem]">
      <ChecklistTracker client:load />
    </div>
  </div>
</ObsidianLayout>
