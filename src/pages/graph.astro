---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import PageHeader from '../components/system/PageHeader.astro';
import MetricStrip from '../components/system/MetricStrip.astro';
import ObsidianGraph from '../components/ObsidianGraph';
import { buildNavigationTree, getAllDocs, getStats } from '../lib/content';
import { buildKnowledgeGraph } from '../lib/graphBuilder';
import {
  Compass,
  GitBranch,
  MousePointerClick,
  Move,
  Search,
  ZoomIn,
} from 'lucide-react';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);
const stats = getStats(allDocs);
const graph = buildKnowledgeGraph(allDocs);

const fmt = new Intl.NumberFormat('en-US');
---

<ObsidianLayout
  title="Knowledge graph"
  description={`Explore the interconnected conceptual graph of ${fmt.format(graph.nodes.length)} notes and ${fmt.format(graph.edges.length)} relationships across Core Java, Spring Boot, System Design, and Algorithms.`}
  navigation={navigation}
  wide
>
  <div class="not-prose space-y-8">
    <!-- Header -->
    <PageHeader eyebrow="03 / BIDIRECTIONAL KNOWLEDGE MESH" title="See how knowledge connects." description="Every node is a full technical chapter; every edge is a resolved architectural reference. Use graph exploration to follow reasoning across the curriculum.">
      <MetricStrip metrics={[{ label:'Knowledge nodes', value:graph.nodes.length },{ label:'Relationships', value:graph.edges.length },{ label:'Domains', value:stats.domains }]} />
      <div slot="footer" class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-obs-border-subtle pt-4 text-xs text-obs-text-muted">
        <span class="inline-flex items-center gap-2"><Move className="h-3.5 w-3.5" />Drag to pan</span><span class="inline-flex items-center gap-2"><ZoomIn className="h-3.5 w-3.5" />Pinch or scroll to zoom</span><span class="inline-flex items-center gap-2"><MousePointerClick className="h-3.5 w-3.5" />Click node to inspect</span>
      </div>
    </PageHeader>


    <!-- Graph Canvas Container with Skeleton Loader Fallback -->
    <div class="relative h-[calc(100dvh-10rem)] min-h-[42rem] w-full overflow-hidden border border-obs-border bg-obs-canvas lg:h-[calc(100vh-16rem)] lg:min-h-[32rem]" style="contain: layout paint;">
      <ObsidianGraph client:only="react">
        <div slot="fallback" class="absolute inset-0 flex w-full flex-col" aria-busy="true" aria-label="Loading knowledge graph">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-obs-border/80 bg-obs-sidebar/85 p-4 lg:h-[156px] 2xl:h-[72px]">
            <div class="flex items-center gap-3">
              <div class="skeleton h-8 w-8 rounded-xl"></div>
              <div class="space-y-2">
                <div class="skeleton h-3 w-40"></div>
                <div class="skeleton h-2.5 w-28"></div>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-1.5">
              {Array.from({ length: 6 }).map(() => (
                <div class="skeleton h-7 w-20 rounded-lg"></div>
              ))}
            </div>
            <div class="flex items-center gap-2">
              <div class="skeleton h-7 w-36 rounded-lg"></div>
              <div class="skeleton h-7 w-24 rounded-lg"></div>
            </div>
          </div>
          <div class="relative flex-1 p-6">
            <div class="grid h-full grid-cols-6 gap-3 opacity-70">
              {Array.from({ length: 24 }).map((_, index) => (
                <div
                  class="skeleton self-center rounded-full"
                  style={`height:${12 + (index % 5) * 6}px;width:${12 + (index % 5) * 6}px`}
                ></div>
              ))}
            </div>
            <p class="mt-4 text-center text-sm font-semibold text-obs-text-primary">Loading Knowledge Graph Mesh…</p>
            <p class="mt-1 text-center text-xs text-obs-text-muted">Resolving {fmt.format(graph.nodes.length)} nodes and {fmt.format(graph.edges.length)} relationship edges</p>
          </div>
        </div>
      </ObsidianGraph>
    </div>

    <!-- Exploration Cards Below Graph -->
    <div class="grid gap-4 sm:grid-cols-3 pt-2">
      <a
        href="/library"
        class="surface-card surface-card-hover group flex flex-col justify-between p-5 transition-all duration-200"
      >
        <div>
          <span class="inline-flex items-center gap-1.5 text-caption font-bold uppercase tracking-[0.12em] text-obs-accent">
            <Compass className="h-3.5 w-3.5" />
            <span>Structured Directory</span>
          </span>
          <h2 class="mt-2 text-base font-bold text-obs-text-primary group-hover:text-obs-accent transition-colors">
            Linear Chapter Catalog
          </h2>
          <p class="mt-1 text-xs leading-relaxed text-obs-text-muted">
            Prefer reading by module? Browse the sequential catalog organized domain-by-domain.
          </p>
        </div>
        <div class="mt-4 flex items-center text-xs font-semibold text-obs-accent group-hover:translate-x-0.5 transition-transform">
          <span>Open Library →</span>
        </div>
      </a>

      <a
        href="/paths"
        class="surface-card surface-card-hover group flex flex-col justify-between p-5 transition-all duration-200"
      >
        <div>
          <span class="inline-flex items-center gap-1.5 text-caption font-bold uppercase tracking-[0.12em] text-obs-gold">
            <GitBranch className="h-3.5 w-3.5" />
            <span>Curated Sequences</span>
          </span>
          <h2 class="mt-2 text-base font-bold text-obs-text-primary group-hover:text-obs-gold transition-colors">
            Learning Paths & Milestones
          </h2>
          <p class="mt-1 text-xs leading-relaxed text-obs-text-muted">
            Follow deliberate study tracks designed to take you from foundational syntax to staff design.
          </p>
        </div>
        <div class="mt-4 flex items-center text-xs font-semibold text-obs-gold group-hover:translate-x-0.5 transition-transform">
          <span>Explore Paths →</span>
        </div>
      </a>

      <a
        href="/glossary"
        class="surface-card surface-card-hover group flex flex-col justify-between p-5 transition-all duration-200"
      >
        <div>
          <span class="inline-flex items-center gap-1.5 text-caption font-bold uppercase tracking-[0.12em] text-obs-emerald">
            <Search className="h-3.5 w-3.5" />
            <span>Exact Concept Anchors</span>
          </span>
          <h2 class="mt-2 text-base font-bold text-obs-text-primary group-hover:text-obs-emerald transition-colors">
            A–Z Technical Glossary
          </h2>
          <p class="mt-1 text-xs leading-relaxed text-obs-text-muted">
            Look up exact definitions, algorithms, keywords, and code mechanisms alphabetically.
          </p>
        </div>
        <div class="mt-4 flex items-center text-xs font-semibold text-obs-emerald group-hover:translate-x-0.5 transition-transform">
          <span>Browse Glossary →</span>
        </div>
      </a>
    </div>
  </div>
</ObsidianLayout>
