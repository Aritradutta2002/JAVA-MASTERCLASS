---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import { buildNavigationTree, getAllDocs } from '../lib/content';
import {
  BookMarked,
  FilterX,
  RotateCcw,
  Search,
} from 'lucide-react';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);

const SKIP = new Set([
  'summary',
  'introduction',
  'overview',
  'conclusion',
  'key takeaways',
  'interview questions',
  'interview questions and answers',
  'further reading',
  'references',
  'table of contents',
  'what you will learn',
  'learning objectives',
  'practice problems',
  'exercises',
  'best practices',
  'common mistakes',
  'real-world example',
  'real world example',
  'code example',
  'example',
  'questions',
  'answers',
  'next steps',
  'recap',
  'resources',
  'appendix',
  'glossary',
  'cheat sheet',
]);

const NOISE = /\b(week|day|q&a|mcq|cheat sheet|notes|scenario|exercise|problem|question|answer|summary|recap|checklist|roadmap|schedule|timeline|table of contents|implementation|visualization|production issue|production note|design question|code walkthrough|dry run|output|solution approach|why it works|when to use|how it works|advanced|beginner|intermediate|expert|basic)\b/i;

const INCLUDED_KINDS = new Set(['article', 'module']);

const terms = new Map<string, { label: string; href: string; doc: string; domain: string; count: number }>();

for (const doc of allDocs) {
  if (!INCLUDED_KINDS.has(doc.kind)) continue;
  for (const heading of doc.headings) {
    if (heading.depth < 2 || heading.depth > 3) continue;
    const label = heading.text.replace(/[*_`]/g, '').trim();
    if (label.length < 4 || label.length > 64) continue;
    if (!/[a-zA-Z]/.test(label)) continue;
    if (/^[$#>\-.]/.test(label)) continue;
    if (/\.(java|md|sql|json|xml|ya?ml|js|ts|html|css)\b/i.test(label)) continue;
    if (SKIP.has(label.toLowerCase())) continue;
    if (NOISE.test(label)) continue;
    if (/^(chapter|part|module|section)\s+\d+/i.test(label)) continue;
    if (label.endsWith('?')) continue;
    if (label.split(/\s+/).length > 8) continue;
    const key = label.toLowerCase();
    const existing = terms.get(key);
    if (existing) {
      existing.count += 1;
    } else {
      terms.set(key, {
        label,
        href: `${doc.slug}#${heading.slug}`,
        doc: doc.title,
        domain: doc.domainTitle,
        count: 1,
      });
    }
  }
}

const sorted = [...terms.values()].sort((a, b) => a.label.localeCompare(b.label, 'en', { sensitivity: 'base' }));
const byLetter = new Map<string, typeof sorted>();
for (const term of sorted) {
  const letter = term.label.charAt(0).toUpperCase();
  const key = /[A-Z]/.test(letter) ? letter : '#';
  if (!byLetter.has(key)) byLetter.set(key, []);
  byLetter.get(key)!.push(term);
}

const allLetters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ#'.split('');
---

<ObsidianLayout
  title="Glossary"
  description="A linked index of technical terms, concepts, and section-level topics across the Java Masterclass."
  navigation={navigation}
  wide
>
  <div class="not-prose space-y-10">
    <!-- Header -->
    <header class="space-y-6 border-b border-obs-border pb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-obs-accent/30 bg-obs-accent/10 px-3 py-1 text-xs font-semibold text-obs-accent">
        <BookMarked className="h-3.5 w-3.5" />
        <span>Canonical Concept Index</span>
      </div>

      <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
        <div>
          <h1 class="text-3xl font-extrabold tracking-tight text-obs-text-primary sm:text-4xl lg:text-5xl">
            Glossary of Technical Concepts
          </h1>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-obs-text-muted sm:text-base">
            Every entry points directly to the exact chapter and section heading that explains it. Generated dynamically from content headers — no generic or fabricated AI definitions.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2 text-xs">
          <div class="rounded-xl border border-obs-border bg-obs-surface/80 px-3.5 py-2 text-center shadow-sm">
            <div class="font-mono text-base font-bold text-obs-text-primary">{sorted.length.toLocaleString('en-US')}</div>
            <div class="text-micro font-medium uppercase tracking-wider text-obs-text-muted">Linked Terms</div>
          </div>
          <div class="rounded-xl border border-obs-border bg-obs-surface/80 px-3.5 py-2 text-center shadow-sm">
            <div class="font-mono text-base font-bold text-obs-accent">{byLetter.size}</div>
            <div class="text-micro font-medium uppercase tracking-wider text-obs-text-muted">Letter Sections</div>
          </div>
        </div>
      </div>

      <!-- Filter Input Form -->
      <div class="space-y-3 pt-2">
        <div class="relative flex items-center">
          <Search className="pointer-events-none absolute left-3.5 h-4 w-4 text-obs-accent" />
          <label for="glossary-filter" class="sr-only">Filter glossary terms</label>
          <input
            id="glossary-filter"
            type="search"
            placeholder="Filter terms (e.g. volatile, CAS, B-tree, Raft, sliding window, HikariCP)…"
            class="field w-full rounded-2xl border border-obs-border bg-obs-surface/90 py-3 pl-10 pr-4 text-sm text-obs-text-primary placeholder:text-obs-text-muted shadow-obs transition-all focus:border-obs-accent focus:outline-none focus:ring-2 focus:ring-obs-accent/20"
            autocomplete="off"
          />
        </div>

        <!-- Alphabetical Quick Jump Navigation Strip -->
        <nav aria-label="Alphabetical jump" class="flex flex-wrap items-center gap-1 pt-1">
          <span class="text-xs font-semibold text-obs-text-muted mr-1">Jump to:</span>
          {allLetters.map((char) => {
            const hasTerms = byLetter.has(char);
            return hasTerms ? (
              <a
                href={`#letter-${char}`}
                class="flex h-7 w-7 items-center justify-center rounded-lg border border-obs-border bg-obs-surface font-mono text-xs font-bold text-obs-text-secondary transition-all hover:border-obs-accent/50 hover:bg-obs-hover hover:text-obs-accent"
              >
                {char}
              </a>
            ) : (
              <span class="flex h-7 w-7 items-center justify-center rounded-lg border border-transparent font-mono text-xs text-obs-text-muted cursor-not-allowed">
                {char}
              </span>
            );
          })}
        </nav>
      </div>

      <div class="flex items-center justify-between text-xs text-obs-text-muted pt-1">
        <p id="glossary-count" aria-live="polite">
          {sorted.length.toLocaleString('en-US')} linked technical terms.
        </p>
        <span>Click any term to jump to the relevant section</span>
      </div>
    </header>

    <!-- Alphabetical Grid of Cards -->
    <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
      {[...byLetter.entries()].map(([letter, list]) => (
        <section
          id={`letter-${letter}`}
          class="glossary-letter surface-card scroll-mt-24 flex flex-col justify-between p-5 shadow-sm transition-all"
          data-letter={letter}
          aria-labelledby={`heading-letter-${letter}`}
        >
          <div>
            <div class="mb-3 flex items-center justify-between border-b border-obs-border-subtle pb-2.5">
              <div class="flex items-center gap-2.5">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg border border-obs-accent/30 bg-obs-accent/10 font-mono text-xs font-bold text-obs-accent">
                  {letter}
                </span>
                <h2 id={`heading-letter-${letter}`} class="text-lg font-bold text-obs-text-primary">
                  {letter}
                </h2>
              </div>
              <span class="font-mono text-xs text-obs-text-muted">{list.length} terms</span>
            </div>

            <ul class="space-y-1">
              {list.map((term) => (
                <li
                  class="glossary-item"
                  data-term={`${term.label} ${term.doc} ${term.domain}`.toLowerCase()}
                >
                  <a
                    href={term.href}
                    class="group flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 transition-colors hover:bg-obs-hover"
                  >
                    <span class="min-w-0 truncate text-xs font-medium text-obs-text-secondary group-hover:text-obs-accent transition-colors">
                      {term.label}
                    </span>
                    <span class="shrink-0 rounded border border-obs-border-subtle bg-obs-canvas-soft px-1.5 py-0.5 text-micro font-medium text-obs-text-muted">
                      {term.domain}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>

    <!-- Empty State (Linear / Algoguru Style) -->
    <div
      id="glossary-empty"
      class="hidden my-12 rounded-hero border border-obs-border bg-gradient-to-b from-obs-surface via-obs-surface/80 to-obs-canvas p-10 text-center shadow-obs-lg sm:p-14"
    >
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-obs-accent/30 bg-obs-accent/10 text-obs-accent shadow-sm">
        <FilterX className="h-7 w-7" />
      </div>
      <h3 class="mt-4 text-xl font-bold tracking-tight text-obs-text-primary sm:text-2xl">
        No terms match that filter
      </h3>
      <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-obs-text-muted">
        We couldn't find any section headings matching your search term. Try a shorter query, or clear the search input to see the full glossary.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <button
          id="glossary-reset-btn"
          type="button"
          class="btn btn-primary shadow-sm"
        >
          <RotateCcw className="h-3.5 w-3.5" />
          Clear Term Filter
        </button>
        <a href="/search" class="btn btn-secondary">
          Try Global Search
        </a>
      </div>
    </div>
  </div>

  <script>
    const input = document.getElementById('glossary-filter') as HTMLInputElement | null;
    const count = document.getElementById('glossary-count');
    const empty = document.getElementById('glossary-empty');
    const resetBtn = document.getElementById('glossary-reset-btn');

    function apply() {
      const query = (input?.value || '').trim().toLowerCase();
      let visible = 0;

      document.querySelectorAll<HTMLElement>('.glossary-letter').forEach((section) => {
        let letterVisible = 0;
        section.querySelectorAll<HTMLElement>('.glossary-item').forEach((item) => {
          const show = !query || (item.dataset.term || '').includes(query);
          item.classList.toggle('hidden', !show);
          if (show) letterVisible += 1;
        });
        section.classList.toggle('hidden', letterVisible === 0);
        visible += letterVisible;
      });

      if (count) {
        count.textContent = `${visible.toLocaleString('en-US')} linked term${visible === 1 ? '' : 's'}.`;
      }
      empty?.classList.toggle('hidden', visible !== 0);
    }

    input?.addEventListener('input', apply);
    resetBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      apply();
    });
  </script>
</ObsidianLayout>
