---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import DomainIcon from '../components/DomainIcon.astro';
import { buildNavigationTree, getAllDocs, getStats } from '../lib/content';
import { DOMAIN_COLORS, DOMAIN_DESCRIPTIONS, DOMAIN_ORDER, DOMAIN_TITLES } from '../lib/constants';
import {
  ArrowRight,
  FileText,
  Library,
  Search,
} from 'lucide-react';

const allDocs = getAllDocs();
const navigation = buildNavigationTree(allDocs);
const stats = getStats(allDocs);


const groups = DOMAIN_ORDER.filter((domain) => allDocs.some((doc) => doc.domain === domain)).map(
  (domain) => {
    const docs = allDocs.filter((doc) => doc.domain === domain);
    const modules = new Map<string, typeof docs>();
    for (const doc of docs) {
      const key = doc.moduleTitle || doc.categoryTitle || 'General';
      if (!modules.has(key)) modules.set(key, []);
      modules.get(key)!.push(doc);
    }
    return {
      domain,
      title: DOMAIN_TITLES[domain] || domain,
      description: DOMAIN_DESCRIPTIONS[domain] || '',
      href: domain === 'root' ? '/overview' : domain === 'java-dsa' ? '/java-dsa' : `/${domain}`,
      docs,
      modules: [...modules.entries()].map(([title, items]) => ({
        title,
        docs: items.sort((a, b) => a.order - b.order || a.title.localeCompare(b.title)),
      })),
      color: DOMAIN_COLORS[domain],
    };
  }
);

const fmt = new Intl.NumberFormat('en-US');
---

<ObsidianLayout
  title="Library"
  description="The complete Java Masterclass library: every domain, module, chapter, and reference note."
  navigation={navigation}
  wide
>
  <div class="not-prose space-y-8">
    <header class="space-y-3 border-b border-obs-border pb-6">
      <p class="eyebrow"><Library className="h-3.5 w-3.5" /> Complete library</p>
      <h1 class="font-serif text-3xl font-bold tracking-tight text-obs-text-primary sm:text-4xl">
        Every chapter, in one place
      </h1>
      <p class="max-w-2xl text-sm leading-relaxed text-obs-text-muted">
        {fmt.format(stats.documents)} documents across {fmt.format(stats.domains)} domains,
        {' '}{fmt.format(stats.words)} words, {fmt.format(stats.codeBlocks)} code blocks, and
        {' '}{fmt.format(stats.mermaidDiagrams)} diagrams. Filter by title, module, or domain.
      </p>

      <div class="flex flex-col gap-2 pt-2">
        <div class="relative flex flex-1 items-center">
          <Search className="pointer-events-none absolute left-2.5 h-4 w-4 text-obs-accent" />
          <label for="library-filter" class="sr-only">Filter the library</label>
          <input
            id="library-filter"
            type="search"
            placeholder="Filter chapters and modules…"
            class="w-full rounded-lg border border-obs-border bg-obs-surface py-2 pl-9 pr-3 text-sm text-obs-text-primary placeholder:text-obs-text-muted focus:border-obs-accent focus:outline-none"
          />
        </div>
        <div class="flex flex-wrap gap-1.5" id="library-domain-filters">
          <button type="button" data-domain="all" class="library-chip is-active">All</button>
          {groups
            .filter((group) => group.domain !== 'root')
            .map((group) => (
              <button type="button" data-domain={group.domain} class="library-chip">
                {group.title}
              </button>
            ))}
        </div>
      </div>
      <p id="library-count" class="text-[0.68rem] text-obs-text-muted" aria-live="polite">
        Showing {fmt.format(stats.documents)} documents.
      </p>
    </header>

    {groups.map((group) => (
      <section class="library-group scroll-mt-24" data-domain={group.domain} aria-labelledby={`domain-${group.domain}`}>
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-3">
            <span
              class="flex h-9 w-9 items-center justify-center rounded-lg border"
              style={{ backgroundColor: group.color?.bg, color: group.color?.text, borderColor: group.color?.border }}
            >
              <DomainIcon domain={group.domain} class="h-4 w-4" />
            </span>
            <div>
              <h2 id={`domain-${group.domain}`} class="font-serif text-xl font-bold text-obs-text-primary">
                {group.title}
              </h2>
              <p class="text-[0.66rem] text-obs-text-muted">
                {group.docs.length} documents · {group.modules.length} modules
              </p>
            </div>
          </div>
          <a href={group.href} class="text-[0.7rem] font-semibold text-obs-accent hover:underline">
            Open domain →
          </a>
        </div>

        <p class="mb-4 max-w-3xl text-[0.78rem] leading-relaxed text-obs-text-muted">{group.description}</p>

        <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
          {group.modules.map((module) => (
            <div class="library-module rounded-xl border border-obs-border bg-obs-surface/60 p-3">
              <div class="flex items-center justify-between border-b border-obs-border-subtle pb-2">
                <h3 class="truncate text-[0.7rem] font-bold uppercase tracking-[0.08em] text-obs-text-muted" title={module.title}>
                  {module.title}
                </h3>
                <span class="font-mono text-[0.6rem] text-obs-text-muted">{module.docs.length}</span>
              </div>
              <ul class="mt-1 divide-y divide-obs-border-subtle">
                {module.docs.map((doc) => (
                  <li
                    class="library-item"
                    data-title={`${doc.title} ${doc.categoryTitle} ${doc.domainTitle}`.toLowerCase()}
                    data-doc-domain={doc.domain}
                  >
                    <a href={doc.slug} class="group flex items-center gap-2 py-1.5">
                      <FileText className="h-3 w-3 shrink-0 text-obs-text-muted group-hover:text-obs-accent" />
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-[0.75rem] font-medium text-obs-text-secondary group-hover:text-obs-accent">
                          {doc.title}
                        </span>
                        <span class="block text-[0.58rem] text-obs-text-muted">
                          {doc.readingTimeMinutes} min · {fmt.format(doc.wordCount)} words
                        </span>
                      </span>
                      <ArrowRight className="h-2.5 w-2.5 shrink-0 text-obs-text-muted opacity-0 transition-opacity group-hover:opacity-100" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}

    <div id="library-empty" class="hidden rounded-xl border border-obs-border bg-obs-surface p-10 text-center">
      <p class="text-sm font-semibold text-obs-text-primary">No chapters match that filter</p>
      <p class="mt-1 text-xs text-obs-text-muted">Try a different term, or clear the filter to see everything.</p>
    </div>
  </div>

  <style>
    .library-chip {
      border: 1px solid var(--obs-border);
      background: var(--obs-surface);
      color: var(--obs-text-muted);
      border-radius: 9999px;
      padding: 0.3rem 0.65rem;
      font-size: 0.65rem;
      font-weight: 600;
      transition: color 140ms ease, border-color 140ms ease, background-color 140ms ease;
    }
    .library-chip:hover {
      color: var(--obs-accent);
      border-color: color-mix(in srgb, var(--obs-accent) 40%, var(--obs-border));
    }
    .library-chip.is-active {
      color: var(--obs-accent);
      border-color: color-mix(in srgb, var(--obs-accent) 50%, var(--obs-border));
      background: var(--obs-accent-subtle);
    }
  </style>

  <script>
    const filter = document.getElementById('library-filter') as HTMLInputElement | null;
    const count = document.getElementById('library-count');
    const empty = document.getElementById('library-empty');
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.library-chip'));
    let activeDomain = 'all';

    function applyFilter() {
      const query = (filter?.value || '').trim().toLowerCase();
      let visible = 0;

      document.querySelectorAll<HTMLElement>('.library-group').forEach((group) => {
        const domain = group.dataset.domain || '';
        const domainMatch = activeDomain === 'all' || activeDomain === domain;
        let groupVisible = 0;

        group.querySelectorAll<HTMLElement>('.library-module').forEach((module) => {
          let moduleVisible = 0;
          module.querySelectorAll<HTMLElement>('.library-item').forEach((item) => {
            const title = item.dataset.title || '';
            const show = domainMatch && (!query || title.includes(query));
            item.classList.toggle('hidden', !show);
            if (show) moduleVisible += 1;
          });
          module.classList.toggle('hidden', moduleVisible === 0);
          groupVisible += moduleVisible;
        });

        group.classList.toggle('hidden', !domainMatch || groupVisible === 0);
        visible += domainVisible(groupVisible);
      });

      function domainVisible(value: number) {
        return value;
      }

      if (count) {
        count.textContent = `Showing ${visible.toLocaleString('en-US')} document${visible === 1 ? '' : 's'}.`;
      }
      empty?.classList.toggle('hidden', visible !== 0);
    }

    filter?.addEventListener('input', applyFilter);
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeDomain = chip.dataset.domain || 'all';
        chips.forEach((item) => item.classList.toggle('is-active', item === chip));
        applyFilter();
      });
    });
  </script>
</ObsidianLayout>
